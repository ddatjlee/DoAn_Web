@model DoAn_Web.Models.Internship

@{
    ViewData["Title"] = "Xem báo cáo đã nộp";
}

<div class="container mt-4">
    <h2>Báo cáo thực tập của bạn</h2>

    @if (!Model.WeeklyReports.Any())
    {
        <div class="alert alert-info">
            Bạn chưa có báo cáo nào.
        </div>
    }
    else
    {
        <div class="reports-list">
            @foreach (var report in Model.WeeklyReports.OrderByDescending(r => r.WeekNumber))
            {
                <div class="report-card">
                    <div class="report-header">
                        <div>
                            <div class="report-week">Tuần @report.WeekNumber</div>
                            <div class="report-company text-muted">@Model.Student?.FullName</div>
                        </div>
                        <div class="report-date">@report.ReportDate.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="report-content">@Html.Raw(report.Content?.Replace("\n", "<br/>"))</div>
                </div>
            }
        </div>
    }
</div>