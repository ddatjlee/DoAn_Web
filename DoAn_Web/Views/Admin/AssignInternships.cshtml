@model IEnumerable<DoAn_Web.Models.Application>

@{
    ViewData["Title"] = "Phân công thực tập";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" href="~/css/assign-custom.css" asp-append-version="true" />

<div class="account-management-container">
    <h2 class="account-management-title">Phân công sinh viên thực tập</h2>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
    }
    else if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Không có đơn ứng tuyển nào được chấp nhận đang chờ phân công.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Sinh viên</th>
                        <th>Công ty</th>
                        <th>Vị trí thực tập</th>
                        <th>Ngày ứng tuyển</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var application in Model)
                    {
                        <tr>
                            <td>
                                @application.Student.FullName<br/>
                                <small class="text-muted">@application.Student.StudentCode</small>
                            </td>
                            <td>@application.Job.Company.Name</td>
                            <td>@application.Job.Title</td>
                            <td>@application.AppliedAt?.ToString("dd/MM/yyyy")</td>
                            @{ 
                                var statusLower = (application.Status ?? "").ToLower();
                                var badgeClass = statusLower.Contains("approved") ? "success" :
                                                 statusLower.Contains("accepted") ? "warning" :
                                                 statusLower.Contains("assigned") ? "primary" : "secondary";
                            }
                            <td>
                                <span class="badge bg-@(badgeClass == "warning" ? "warning" : badgeClass == "primary" ? "info" : badgeClass)">@application.Status</span>
                            </td>
                            <td>
                                <button type="button" class="btn btn-info uniform-btn" 
                                        data-modal-open="assignModalBackdrop"
                                        data-application-id="@application.ApplicationId"
                                        data-student-name="@application.Student.FullName"
                                        data-company-name="@application.Job.Company.Name"
                                        aria-label="Phân công @application.Student.FullName">
                                    Phân công
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Custom modal phân công (no Bootstrap) -->
<div id="assignModalBackdrop" class="modal-custom-backdrop" aria-hidden="true">
    <div class="modal-custom" role="dialog" aria-modal="true" aria-labelledby="assignModalTitle">
        <div class="modal-header-custom">
            <h5 id="assignModalTitle">Phân công thực tập</h5>
            <button class="modal-close" data-modal-close="assignModalBackdrop" aria-label="Đóng">✕</button>
        </div>
        <form id="assignForm" asp-controller="Admin" asp-action="AssignInternship" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body-custom">
                <input type="hidden" name="applicationId" id="applicationId" />
                <p class="mb-2">Phân công thực tập cho sinh viên <strong id="studentName"></strong> tại công ty <strong id="companyName"></strong></p>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="supervisorInput">Giảng viên hướng dẫn</label>
                        <!-- searchable input using datalist; hidden input holds the selected supervisorId -->
                        <input id="supervisorInput" name="supervisorInput" list="supervisorList" class="form-input" placeholder="Gõ tên giảng viên..." autocomplete="off" required />
                        <datalist id="supervisorList">
                            @foreach (var supervisor in ViewBag.Supervisors)
                            {
                                <option value="@supervisor.Name"></option>
                            }
                        </datalist>
                        <input type="hidden" id="supervisorIdHidden" name="supervisorId" />
                        <div class="form-help">Gõ để tìm và chọn giảng viên. Nếu không tồn tại, vui lòng liên hệ quản trị.</div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="startDate">Ngày bắt đầu</label>
                        <input id="startDate" name="startDate" type="text" class="form-input" placeholder="Chọn ngày" required />
                        <div class="form-help">Chọn ngày bắt đầu (ngày phải từ hôm nay trở đi).</div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="endDate">Ngày kết thúc</label>
                        <input id="endDate" name="endDate" type="text" class="form-input" placeholder="Chọn ngày" />
                        <div class="form-help">Không bắt buộc. Nếu bỏ trống, hệ thống mặc định 2 tháng kể từ ngày bắt đầu.</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn-custom" data-modal-close="assignModalBackdrop">Đóng</button>
                <button type="submit" class="btn-custom filled">Xác nhận</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        // Custom modal & form JS (no Bootstrap)
        document.addEventListener('DOMContentLoaded', function () {
            var backdrop = document.getElementById('assignModalBackdrop');
            var assignForm = document.getElementById('assignForm');

            function openModal() {
                if (!backdrop) return;
                backdrop.style.display = 'flex';
                backdrop.setAttribute('aria-hidden', 'false');
            }
            function closeModal() {
                if (!backdrop) return;
                backdrop.style.display = 'none';
                backdrop.setAttribute('aria-hidden', 'true');
                // clear inline validation state
                if (assignForm) assignForm.classList.remove('was-validated');
                var err = backdrop.querySelector('.assign-error');
                if (err) err.remove();
            }

            // Open modal buttons
            var openers = document.querySelectorAll('[data-modal-open]');
            openers.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    try {
                        var target = btn.getAttribute('data-modal-open');
                        if (!target || !backdrop || backdrop.id !== target) {
                            // if target mismatches, find by id
                        }
                        var applicationId = btn.getAttribute('data-application-id') || '';
                        var studentName = btn.getAttribute('data-student-name') || '';
                        var companyName = btn.getAttribute('data-company-name') || '';

                        // populate
                        var inputAppId = document.querySelector('#applicationId');
                        var elStudent = document.querySelector('#studentName');
                        var elCompany = document.querySelector('#companyName');
                        if (inputAppId) inputAppId.value = applicationId;
                        if (elStudent) elStudent.textContent = studentName;
                        if (elCompany) elCompany.textContent = companyName;
                        console.log('Assign button click populated modal', { applicationId, studentName, companyName });
                        openModal();
                    } catch (err) {
                        console.error('Error opening assign modal', err);
                    }
                });
            });

            // Close buttons
            var closers = document.querySelectorAll('[data-modal-close]');
            closers.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    closeModal();
                });
            });

            // click outside to close
            if (backdrop) {
                backdrop.addEventListener('click', function (e) {
                    if (e.target === backdrop) closeModal();
                });
            }

            // Form submit guard & client validation
            if (assignForm) {
                assignForm.addEventListener('submit', function (e) {
                    var appId = assignForm.querySelector('#applicationId')?.value || '';
                    var sup = assignForm.querySelector('#supervisorIdHidden')?.value || '';
                    var start = assignForm.querySelector('#startDate')?.value || '';
                    var end = assignForm.querySelector('#endDate')?.value || '';
                    console.log('AssignInternship submit', { applicationId: appId, supervisorId: sup, startDate: start, endDate: end });

                    if (!appId) {
                        e.preventDefault();
                        e.stopPropagation();
                        console.error('Prevented submit: applicationId is empty');
                        var existing = backdrop.querySelector('.assign-error');
                        if (!existing) {
                            var alert = document.createElement('div');
                            alert.className = 'alert alert-error assign-error';
                            alert.textContent = 'Không thể gửi: mã đơn trống. Vui lòng đóng modal và thử lại.';
                            var body = backdrop.querySelector('.modal-body-custom');
                            if (body) body.prepend(alert);
                        }
                        return false;
                    }

                    // native form validation
                    if (!assignForm.checkValidity()) {
                        e.preventDefault();
                        e.stopPropagation();
                        assignForm.classList.add('was-validated');
                        // highlight invalid fields
                        var elems = assignForm.querySelectorAll('[required]');
                        elems.forEach(function (el) {
                            if (!el.checkValidity()) el.classList.add('invalid');
                            else el.classList.remove('invalid');
                        });
                        return false;
                    }

                    // custom validation: if endDate filled, must be >= startDate
                    if (start && end) {
                        try {
                            var s = new Date(start);
                            var d = new Date(end);
                            if (d < s) {
                                e.preventDefault();
                                e.stopPropagation();
                                alert('Ngày kết thúc phải sau hoặc bằng ngày bắt đầu.');
                                return false;
                            }
                        } catch {}
                    }

                    // allow submit; modal will be closed on server redirect
                    return true;
                }, false);
            }

            // --- Supervisor searchable input handling ---
            // Build a name->id map from server data
            var supervisorMap = {};
            (function () {
                try {
                    // populate map using server-side rendered options
                    var opts = document.querySelectorAll('#supervisorList option');
                    opts.forEach(function (opt) {
                        var name = opt.value || opt.textContent || '';
                        // Attempt to find matching supervisor element in the table of options via server-side loop
                        // We can't get id from datalist options, so build map from ViewBag by embedding JSON-free structure
                    });
                } catch (err) {
                    // ignore
                }
            })();

            // Instead of relying on datalist for id, build map from a JSON blob rendered server-side
            (function () {
                var raw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Supervisors ?? new List<object>()));
                try {
                    raw.forEach(function (s) {
                        if (s && s.Name) supervisorMap[s.Name] = s.SupervisorId;
                    });
                } catch (err) {
                    // If JSON parsing fails, fallback to empty map
                    supervisorMap = {};
                }

                var supInput = document.getElementById('supervisorInput');
                var supHidden = document.getElementById('supervisorIdHidden');
                if (supInput) {
                    supInput.addEventListener('input', function () {
                        var v = supInput.value || '';
                        if (supervisorMap[v]) {
                            supHidden.value = supervisorMap[v];
                            supInput.classList.remove('invalid');
                        } else {
                            supHidden.value = '';
                        }
                    });
                }
            })();

            // --- Initialize flatpickr on startDate & endDate ---
            (function () {
                try {
                    if (typeof flatpickr === 'function') {
                        var endPicker;
                        var startPicker = flatpickr('#startDate', {
                            dateFormat: 'Y-m-d',
                            minDate: 'today',
                            altInput: true,
                            altFormat: 'd/m/Y',
                            onChange: function(selectedDates) {
                                try {
                                    if (endPicker && selectedDates && selectedDates[0]) {
                                        var s = selectedDates[0];
                                        endPicker.set('minDate', s);
                                        // Gợi ý mặc định +2 tháng từ start
                                        var d = new Date(s.getTime());
                                        d.setMonth(d.getMonth() + 2);
                                        endPicker.setDate(d, false);
                                    }
                                } catch {}
                            }
                        });
                        endPicker = flatpickr('#endDate', {
                            dateFormat: 'Y-m-d',
                            altInput: true,
                            altFormat: 'd/m/Y'
                        });
                    }
                } catch (err) {
                    // ignore
                }
            })();
        });
    </script>
}