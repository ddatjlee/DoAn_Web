@model List<DoAn_Web.Models.Internship>

<div class="application-list-container">
    <h2 class="company-profile-title">Danh sách sinh viên thực tập</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="evaluation-empty" style="background:#e6ffed; padding:.75rem; border-radius:8px; margin-bottom:1rem;">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="evaluation-empty" style="background:#fff2f2; padding:.75rem; border-radius:8px; margin-bottom:1rem;">@TempData["ErrorMessage"]</div>
    }

    <div style="display:flex; flex-direction:column; gap:.75rem;">
        @foreach (var internship in Model)
        {
            <div class="report-card" style="display:flex; align-items:center; gap:1rem; justify-content:space-between;">
                <div style="display:flex; gap:1rem; align-items:center; min-width:0;">
                    <div style="width:64px; height:64px; border-radius:8px; overflow:hidden; background:#f1f5f9; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                        @if (!string.IsNullOrEmpty(internship.Student.AvatarUrl))
                        {
                            <img src="@internship.Student.AvatarUrl" alt="avatar" style="width:64px; height:64px; object-fit:cover;" />
                        }
                        else
                        {
                            <div style="font-weight:700; color:#6c757d;">@internship.Student.FullName?.Split(' ').LastOrDefault()?.Substring(0,1)</div>
                        }
                    </div>

                    <div style="min-width:0;">
                        <div style="font-weight:700; color:#343a40;">@internship.Student.FullName</div>
                        <div style="color:#6c757d; font-size:.92rem; margin-top:.2rem;">Mã SV: @internship.Student.StudentCode • @internship.Company.Name</div>
                        <div style="color:#6c757d; font-size:.9rem; margin-top:.18rem;">Bắt đầu: @internship.StartDate.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>

                <div style="display:flex; gap:.6rem; align-items:center;">
                    <div style="text-align:right; min-width:120px;">
                        <div style="margin-bottom:.4rem;">Báo cáo: <strong>@internship.WeeklyReports.Count</strong></div>
                        <div>
                            <span class="status-pill @(internship.Status?.ToLower() == "completed" ? "submitted" : "pending")">@internship.Status</span>
                        </div>
                    </div>

                    <div style="display:flex; align-items: center; justify-content: center; ; gap:.4rem;">
                        <a href="@Url.Action("ViewStudentReports", "Supervisor", new { studentId = internship.StudentId })" class="btn btn-outline-dark btn-sm uniform-btn">Xem báo cáo</a>
                        @{
                            var hasEvaluation = internship.SupervisorEvaluation != null;
                            var hasCompanyEvaluation = internship.CompanyEvaluation != null;
                        }
                        @if (!hasEvaluation)
                        {
                            <a href="@Url.Action("EvaluateIntern", "Supervisor", new { internshipId = internship.InternshipId })" class="btn btn-primary btn-sm uniform-btn no-padding">Đánh giá</a>
                        }
                        else
                        {
                            <div style="display:flex; align-items:center; gap:.4rem;">
                                <div class="score-circle" style="width:44px; height:44px; border-width:2px;">
                                    <div class="value" style="font-size:.95rem;">@internship.SupervisorEvaluation.Score</div>
                                </div>
                                <div style="no-padding;font-size:.9rem; color:#157347;">Đã đánh giá (@internship.SupervisorEvaluation.Score/10)</div>
                            </div>
                        }
                        @if (hasCompanyEvaluation)
                        {
                            <a href="@Url.Action("ViewCompanyEvaluation", "Supervisor", new { internshipId = internship.InternshipId })" class="btn btn-info btn-sm uniform-btn">Công ty</a>
                        }

                        @* Mark complete form *@
                        @if ((internship.Status ?? "").Trim() != "Hoàn thành")
                        {
                            <form asp-action="MarkInternshipComplete" asp-controller="Supervisor" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="internshipId" value="@internship.InternshipId" />
                                <button type="submit" class="btn btn-outline-dark btn-sm uniform-btn btn-color" title="Đánh dấu hoàn thành" onclick="return confirm('Bạn có chắc muốn đánh dấu thực tập này là Hoàn thành? Hành động này sẽ cập nhật trạng thái và có thể thiết lập ngày kết thúc.')">Hoàn thành</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>