@model IEnumerable<DoAn_Web.Models.Internship>

<div class="account-management-container">
    <h2 class="account-management-title">Danh sách báo cáo thực tập của sinh viên</h2>

    @foreach (var internship in Model)
    {
        <div class="student-card">
            <!-- Student Header Info -->
            <div class="student-header">
                <div class="student-info-left">
                    <div class="student-avatar">
                        @if (!string.IsNullOrEmpty(internship.Student.AvatarUrl))
                        {
                            <img src="@internship.Student.AvatarUrl" alt="@internship.Student.FullName" />
                        }
                        else
                        {
                            <span>@internship.Student.FullName?.Split(' ').LastOrDefault()?.Substring(0,1)</span>
                        }
                    </div>
                    <div class="student-details">
                        <h3>@internship.Student.FullName</h3>
                        <div class="student-meta">
                            <span><i class="fas fa-id-card"></i> @internship.Student.StudentCode</span>
                            <span><i class="fas fa-building"></i> @internship.Company.Name</span>
                        </div>
                        <div class="student-meta">
                            <span><i class="fas fa-calendar"></i> @internship.StartDate.ToString("dd/MM/yyyy") - @(internship.EndDate?.ToString("dd/MM/yyyy") ?? "Hiện tại")</span>
                        </div>
                    </div>
                </div>

                <div class="student-info-right">
                    <div class="student-stats">
                        <div class="stat-item">
                            <strong>Số báo cáo:</strong> @internship.WeeklyReports.Count
                        </div>
                        <div class="stat-item">
                            @if (internship.Status?.ToLower() == "completed")
                            {
                                <span class="status-text approved">Hoàn thành</span>
                            }
                            else if (internship.Status?.ToLower() == "in progress")
                            {
                                <span class="status-text pending">Đang thực tập</span>
                            }
                            else
                            {
                                <span class="status-text">@internship.Status</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Weekly Reports List -->
            <div class="reports-section">
                <h4 class="section-subtitle">
                    <i class="fas fa-file-alt"></i> Báo cáo tuần
                </h4>
                
                @if (!internship.WeeklyReports.Any())
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> Chưa có báo cáo nào.
                    </div>
                }
                else
                {
                    <div class="reports-list">
                        @foreach (var report in internship.WeeklyReports.OrderByDescending(r => r.WeekNumber))
                        {
                            <div class="report-item">
                                <div class="report-item-header" onclick="this.parentElement.classList.toggle('expanded')">
                                    <div class="report-item-left">
                                        <strong>Tuần @report.WeekNumber</strong>
                                        <span class="report-date">@report.ReportDate.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="report-item-right">
                                        @switch (report.Status?.ToLower())
                                        {
                                            case "approved":
                                                <span class="status-text approved">Đã duyệt</span>
                                                break;
                                            case "rejected":
                                                <span class="status-text rejected">Từ chối</span>
                                                break;
                                            default:
                                                <span class="status-text pending">Chờ duyệt</span>
                                                break;
                                        }
                                    </div>
                                </div>

                                <div class="report-item-body">
                                    <pre class="report-text">@report.Content</pre>

                                    @if (report.Status?.ToLower() == "approved")
                                    {
                                        <div class="feedback-box approved">
                                            <h5>
                                                <i class="fas fa-check-circle"></i> Nhận xét của giảng viên
                                            </h5>
                                            <p>@report.SupervisorComment</p>
                                            <small>Duyệt lúc: @report.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")</small>
                                        </div>
                                    }
                                    else if (report.Status?.ToLower() == "rejected")
                                    {
                                        <div class="feedback-box rejected">
                                            <h5>
                                                <i class="fas fa-times-circle"></i> Lý do từ chối
                                            </h5>
                                            <p>@report.SupervisorComment</p>
                                            <small>Từ chối lúc: @report.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="report-actions">
                                            <a href="@Url.Action("ReviewReport", "Supervisor", new { reportId = report.ReportId })" class="btn btn-success uniform-btn">
                                                Duyệt
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Action Buttons -->
            @if ((internship.Status ?? "").Trim() != "Hoàn thành")
            {
                <div class="card-footer-actions">
                    <form asp-action="MarkInternshipComplete" asp-controller="Supervisor" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="internshipId" value="@internship.InternshipId" />
                        <button type="submit" class="btn btn-warning uniform-btn" onclick="return confirm('Bạn có chắc muốn đánh dấu thực tập này là Hoàn thành?')">
                            <i class="fas fa-flag-checkered"></i> Đánh dấu hoàn thành
                        </button>
                    </form>
                </div>
            }
        </div>
    }
</div>

<style>
    .student-card {
        background: #fff;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
        transition: all 0.3s ease;
    }

    .student-card:hover {
        border-color: #28a745;
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.1);
    }

    .student-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 20px;
        border-bottom: 2px solid #e9ecef;
        margin-bottom: 20px;
    }

    .student-info-left {
        display: flex;
        gap: 15px;
        align-items: center;
        flex: 1;
    }

    .student-avatar {
        width: 70px;
        height: 70px;
        border-radius: 12px;
        overflow: hidden;
        background: linear-gradient(135deg, #28a745, #20c997);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .student-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .student-avatar span {
        color: white;
        font-weight: 700;
        font-size: 1.8rem;
    }

    .student-details h3 {
        margin: 0 0 8px 0;
        color: #333;
        font-size: 1.3rem;
        font-weight: 600;
    }

    .student-meta {
        color: #6c757d;
        font-size: 0.9rem;
        margin-top: 5px;
    }

    .student-meta span {
        margin-right: 15px;
    }

    .student-meta i {
        color: #28a745;
        margin-right: 5px;
    }

    .student-info-right {
        text-align: right;
        min-width: 220px;
    }

    .student-stats {
        margin-bottom: 12px;
    }

    .stat-item {
        margin-bottom: 8px;
        font-size: 0.95rem;
    }

    .student-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .section-subtitle {
        color: #28a745;
        font-size: 1.1rem;
        font-weight: 600;
        margin: 20px 0 15px 0;
        padding-bottom: 8px;
        border-bottom: 2px solid #28a745;
    }

    .section-subtitle i {
        margin-right: 8px;
        color: #20c997;
    }

    .reports-section {
        margin-top: 20px;
    }

    .reports-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .report-item {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .report-item:hover {
        border-color: #28a745;
    }

    .report-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 15px;
        cursor: pointer;
        background: #fff;
        transition: background 0.3s ease;
    }

    .report-item-header:hover {
        background: #f8f9fa;
    }

    .report-item-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .report-item-left strong {
        color: #333;
        font-size: 1rem;
    }

    .report-date {
        color: #6c757d;
        font-size: 0.85rem;
    }

    .report-item-body {
        padding: 15px;
        border-top: 1px solid #e9ecef;
        background: #fff;
        display: none;
    }

    .report-item.expanded .report-item-body {
        display: block;
    }

    .report-text {
        white-space: pre-wrap;
        word-wrap: break-word;
        margin: 0 0 15px 0;
        padding: 15px;
        background-color: #f8f9fa;
        border-left: 4px solid #28a745;
        border-radius: 4px;
        font-family: 'Courier New', monospace;
        font-size: 0.9rem;
        color: #333;
    }

    .feedback-box {
        margin-top: 15px;
        padding: 15px;
        border-radius: 6px;
        border-left: 4px solid #28a745;
    }

    .feedback-box.approved {
        background-color: #f0f7f4;
        border-left-color: #28a745;
    }

    .feedback-box.rejected {
        background-color: #f8d7da;
        border-left-color: #dc3545;
    }

    .feedback-box h5 {
        color: #28a745;
        font-weight: 600;
        font-size: 1rem;
        margin: 0 0 10px 0;
    }

    .feedback-box.rejected h5 {
        color: #dc3545;
    }

    .feedback-box p {
        margin: 0 0 8px 0;
        color: #495057;
    }

    .feedback-box small {
        color: #6c757d;
        font-size: 0.85rem;
    }

    .report-actions {
        margin-top: 15px;
        display: flex;
        gap: 10px;
    }

    .card-footer-actions {
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #e9ecef;
        text-align: right;
    }

    .status-text {
        font-weight: 600;
        font-size: 0.95rem;
    }

    .status-text.pending {
        color: #ff9800;
    }

    .status-text.approved {
        color: #28a745;
    }

    .status-text.rejected {
        color: #dc3545;
    }

    .uniform-btn {
        padding: 6px 12px;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 6px;
        transition: all 0.3s ease;
    }

    .btn-info.uniform-btn {
        background-color: #0066cc;
        border-color: #0066cc;
        color: white;
    }

    .btn-info.uniform-btn:hover {
        background-color: #0052a3;
        border-color: #0052a3;
    }

    .btn-success.uniform-btn {
        background-color: #28a745;
        border-color: #28a745;
        color: white;
    }

    .btn-success.uniform-btn:hover {
        background-color: #218838;
        border-color: #1e7e34;
    }

    .btn-warning.uniform-btn {
        background-color: #ff9800;
        border-color: #ff9800;
        color: white;
    }

    .btn-warning.uniform-btn:hover {
        background-color: #e68900;
        border-color: #cc7a00;
    }

    .btn-outline-secondary.uniform-btn {
        background-color: transparent;
        border: 1px solid #6c757d;
        color: #6c757d;
    }

    .btn-outline-secondary.uniform-btn:hover {
        background-color: #6c757d;
        color: white;
    }

    @@media (max-width: 768px) {
        .student-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .student-info-right {
            width: 100%;
            text-align: left;
        }

        .student-actions {
            justify-content: flex-start;
            width: 100%;
        }

        .report-item-left {
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
        }
    }
</style>