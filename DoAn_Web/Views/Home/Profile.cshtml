@model DoAn_Web.Models.Student

@{
    ViewData["Title"] = "Profile";
}

<h2>Thông tin cá nhân</h2>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

@if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
{
        <div class="alert alert-success">@ViewBag.SuccessMessage</div>
}

<form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="FullName">Họ và tên</label>
        <input asp-for="FullName" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="StudentCode">Mã sinh viên</label>
        <input asp-for="StudentCode" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="DateOfBirth">Ngày sinh</label>
        <input asp-for="DateOfBirth" class="form-control" type="date" />
    </div>

    <div class="form-group">
        <label asp-for="Phone">Số điện thoại</label>
        <input asp-for="Phone" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Gpa">Điểm GPA</label>
        <input asp-for="Gpa" class="form-control" step="0.01" />
    </div>

    <div class="form-group">
        <label asp-for="GraduationYear">Năm tốt nghiệp</label>
        <input asp-for="GraduationYear" class="form-control" type="number" />
    </div>

    <div class="form-group">
        <label asp-for="GitHubProfile">GitHub Profile</label>
        <input asp-for="GitHubProfile" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="AvatarUrl">Ảnh đại diện</label>
        <input asp-for="AvatarUrl" type="file" class="form-control-file" name="avatarFile" />
        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
        {
                <img src="@Model.AvatarUrl" alt="Avatar" style="max-width: 200px; max-height: 200px;" />
        }
    </div>

    <div class="form-group">
        <label>Kỹ năng</label>
        @foreach (var skill in ViewBag.Skills as List<DoAn_Web.Models.Skill>)
        {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="SelectedSkillIds" value="@skill.SkillId"
                @(Model.StudentSkills?.Any(ss => ss.SkillID == skill.SkillId) == true ? "checked" : "") />
                    <label class="form-check-label">@skill.Name</label>
                </div>
        }
    </div>

    <input type="hidden" asp-for="StudentId" />
    <button type="submit" class="btn btn-primary">Cập nhật thông tin</button>
</form>