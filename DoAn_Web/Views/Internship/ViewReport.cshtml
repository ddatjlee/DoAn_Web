@model WeeklyReport

@{
    ViewData["Title"] = "Chi tiết báo cáo";
}

<div class="account-management-container">
    <a href="javascript:history.back()" style="margin-bottom: 20px; display: inline-block; color: #28a745; text-decoration: none; font-weight: 600;">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>

    <h2 class="account-management-title">Báo cáo tuần @Model.WeekNumber</h2>

    <div class="report-info-grid">
        <div class="info-row">
            <span class="label">Sinh viên</span>
            <span class="value">@Model.Internship.Student.FullName<br><small style="color: #6c757d;">@Model.Internship.Student.StudentCode</small></span>
        </div>
        <div class="info-row">
            <span class="label">Công ty</span>
            <span class="value">@Model.Internship.Company.Name</span>
        </div>
        <div class="info-row">
            <span class="label">Ngày báo cáo</span>
            <span class="value">@Model.ReportDate.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <div class="info-row">
            <span class="label">Trạng thái</span>
            <span class="value">
                @switch (Model.Status?.ToLower())
                {
                    case "pending":
                        <span class="status-badge pending">Chờ duyệt</span>
                        break;
                    case "approved":
                        <span class="status-badge approved">Đã duyệt</span>
                        break;
                    case "rejected":
                        <span class="status-badge rejected">Đã từ chối</span>
                        break;
                    default:
                        <span class="status-badge">@Model.Status</span>
                        break;
                }
            </span>
        </div>
    </div>

    <div class="report-section">
        <h5><i class="fas fa-file-alt"></i> Nội dung báo cáo</h5>
        <div class="report-content">
            <pre>@Model.Content</pre>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SupervisorComment))
    {
        <div class="report-section feedback-section">
            <h5><i class="fas fa-comment-dots"></i> Nhận xét từ giảng viên</h5>
            <div class="feedback-box">
                <p>@Model.SupervisorComment</p>
                @if (Model.ReviewedAt.HasValue)
                {
                    <small>Đánh giá lúc: @Model.ReviewedAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                }
            </div>
        </div>
    }
</div>

<style>
    .report-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 12px;
        margin-bottom: 20px;
    }

    .info-row {
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 12px;
        background: #fdfefe;
    }

    .info-row .label {
        display: block;
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 4px;
    }

    .info-row .value {
        display: block;
        font-weight: 600;
        color: #212529;
        font-size: 0.95rem;
    }

    .report-section {
        margin-top: 20px;
        padding: 18px;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        background: #fff;
    }

    .report-section h5 {
        margin: 0 0 12px 0;
        font-size: 1.1rem;
        color: #28a745;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .report-section h5 i {
        font-size: 1.15rem;
    }

    .report-content {
        background: #f8f9fa;
        padding: 16px;
        border-radius: 8px;
        border-left: 4px solid #28a745;
    }

    .report-content pre {
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        white-space: pre-wrap;
        word-wrap: break-word;
        color: #333;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .feedback-section h5 {
        color: #20c997;
    }

    .feedback-box {
        background: #ecfdf3;
        border-left-color: #20c997;
        padding: 16px;
        border-radius: 8px;
        border: 2px solid #20c997;
    }

    .feedback-box p {
        margin: 0 0 8px 0;
        color: #065f46;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .feedback-box small {
        color: #0b5e4e;
        font-size: 0.85rem;
    }

    @@media (max-width: 768px) {
        .report-info-grid {
            grid-template-columns: 1fr;
        }
    }

    .status-badge {
        display: inline;
        padding: 0;
        font-weight: 600;
        font-size: 0.95rem;
        border: none;
    }

    .status-badge.pending {
        color: #ff9800;
    }

    .status-badge.approved {
        color: #28a745;
    }

    .status-badge.rejected {
        color: #dc3545;
    }

</style>