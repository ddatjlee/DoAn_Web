@model WeeklyReport

@{
    ViewData["Title"] = "Chi tiết báo cáo";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h3>Báo cáo tuần @Model.WeekNumber</h3>
            <p class="mb-0">Sinh viên: @Model.Internship.Student.FullName</p>
            <small>Ngày nộp: @Model.ReportDate.ToString("dd/MM/yyyy HH:mm")</small>
        </div>
        <div class="card-body">
            <p class="card-text">@Model.Content</p>
        </div>
    </div>

    <div class="mt-3">
        <a href="javascript:history.back()" class="btn btn-secondary">Quay lại</a>
    </div>
</div>