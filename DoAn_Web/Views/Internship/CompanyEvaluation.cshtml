        background: #fff;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
        transition: all 0.3s ease;
    }

    .eval-student-card:hover {
        border-color: #28a745;
    }

    .eval-student-info {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .eval-student-avatar {
        width: 70px;
        height: 70px;
        border-radius: 12px;
        overflow: hidden;
        background: linear-gradient(135deg, #28a745, #20c997);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .eval-student-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .eval-student-avatar span {
        color: white;
        font-weight: 700;
        font-size: 1.8rem;
    }

    .eval-student-details h3 {
        margin: 0 0 8px 0;
        color: #333;
        font-size: 1.2rem;
        font-weight: 600;
    }

    .eval-meta {
        display: flex;
        gap: 15px;
        color: #6c757d;
        font-size: 0.9rem;
        margin-top: 5px;
    }

    .eval-status {
        margin-top: 8px;
    }

    .eval-form {
        margin-top: 20px;
    }

    .report-section {
        background: #fff;
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .report-section h5 {
        color: #28a745;
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0 0 15px 0;
        padding-bottom: 8px;
        border-bottom: 2px solid #28a745;
    }

    .criteria-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .criteria-item {
        display: flex;
        flex-direction: column;
    }

    .criteria-item label {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
        font-size: 0.95rem;
    }

    .criteria-item input {
        padding: 8px 10px;
        border: 2px solid #e9ecef;
        border-radius: 5px;
        font-size: 0.85rem;
        transition: border-color 0.3s ease;
        height: auto;
    }

    .criteria-item input:focus {
        outline: none;
        border-color: #28a745;
        box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.1);
    }

    .criteria-item small {
        color: #6c757d;
        font-size: 0.8rem;
        margin-top: 4px;
    }

    .eval-score-box {
        background: #f0f7f4;
        border: 2px solid #20c997;
        border-radius: 6px;
        padding: 10px 12px;
        text-align: center;
    }

    .score-display {
        font-size: 0.95rem;
        font-weight: 600;
        color: #28a745;
    }

    .score-display span {
        font-size: 1.2rem;
        font-weight: 800;
        color: #28a745;
        margin-left: 8px;
    }

    .eval-score-box small {
        display: block;
        color: #6c757d;
        font-size: 0.8rem;
        margin-top: 4px;
    }

    .form-control-custom {
        width: 100%;
        padding: 12px 14px;
        border: 2px solid #e9ecef;
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        resize: vertical;
    }

    .form-control-custom:focus {
        outline: none;
        border-color: #28a745;
        box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.1);
    }

    .alert {
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid #0c63e4;
        background-color: #cfe2ff;
        color: #084298;
        margin-bottom: 20px;
    }

    .alert strong {
        font-weight: 600;
    }

    .eval-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .btn {
        padding: 10px 20px;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .uniform-btn {
        padding: 8px 16px;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-success {
        background-color: #28a745;
        color: white;
        border: 1px solid #28a745;
    }

    .btn-success:hover {
        background-color: #218838;
        border-color: #1e7e34;
    }

    .btn-outline-secondary {
        background-color: transparent;
        color: #6c757d;
        border: 1px solid #6c757d;
    }

    .btn-outline-secondary:hover {
        background-color: #6c757d;
        color: white;
    }

    .status-text {
        font-weight: 600;
        font-size: 0.95rem;
    }

    .status-text.pending {
        color: #ff9800;
    }

    .status-text.approved {
        color: #28a745;
    }

    .status-text.rejected {
        color: #dc3545;
    }

    @@media (max-width: 768px) {
        .eval-student-info {
            flex-direction: column;
            align-items: flex-start;
        }

        .criteria-grid {
            grid-template-columns: 1fr;
        }

        .eval-actions {
            flex-direction: column;
        }

        .eval-actions .btn {
            width: 100%;
        }
    }
    /* Legal Basis Modal */
    .legal-modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.6);
