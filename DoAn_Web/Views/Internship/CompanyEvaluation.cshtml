@model DoAn_Web.Models.Internship

<div class="account-management-container">
    <h2 class="account-management-title">Đánh giá sinh viên thực tập</h2>

    <!-- Student Info Section -->
    <div class="eval-student-card">
        <div class="eval-student-info">
            <div class="eval-student-avatar">
                @if (!string.IsNullOrEmpty(Model.Student.AvatarUrl))
                {
                    <img src="@Model.Student.AvatarUrl" alt="@Model.Student.FullName" />
                }
                else
                {
                    <span>@Model.Student.FullName?.Split(' ').LastOrDefault()?.Substring(0,1)</span>
                }
            </div>
            <div class="eval-student-details">
                <h3>@Model.Student.FullName</h3>
                <div class="eval-meta">
                    <span>@Model.Student.StudentCode</span>
                    <span>@Model.StartDate.ToString("dd/MM/yyyy") - @(Model.EndDate?.ToString("dd/MM/yyyy") ?? "Hiện tại")</span>
                </div>
                <div class="eval-status">
                    @if (Model.Status?.ToLower() == "hoàn thành" || Model.Status?.ToLower() == "completed")
                    {
                        <span class="status-text approved">Hoàn thành</span>
                    }
                    else
                    {
                        <span class="status-text">@Model.Status</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Evaluation Form -->
    <form asp-action="CompanyEvaluation" method="post" id="evaluationForm" class="eval-form">
        <input type="hidden" name="internshipId" value="@Model.InternshipId" />

        <!-- Criteria Section -->
        <div class="report-section">
            <h5>Tiêu chí đánh giá (Thang điểm 10)</h5>

            <div class="criteria-grid">
                <div class="criteria-item">
                    <label>1. Chấp hành nội quy</label>
                    <input type="number" class="criteria-input" name="criteriaCompliance" min="0" max="10" step="0.5" required value="@(Model.CompanyEvaluation?.CriteriaCompliance ?? 0)" />
                    <small>Điểm 0–10 (có thể 0.5)</small>
                </div>

                <div class="criteria-item">
                    <label>2. Thực hiện nhiệm vụ</label>
                    <input type="number" class="criteria-input" name="criteriaTaskPerformance" min="0" max="10" step="0.5" required value="@(Model.CompanyEvaluation?.CriteriaTaskPerformance ?? 0)" />
                </div>

                <div class="criteria-item">
                    <label>3. Quan hệ, giao tiếp</label>
                    <input type="number" class="criteria-input" name="criteriaRelationship" min="0" max="10" step="0.5" required value="@(Model.CompanyEvaluation?.CriteriaRelationship ?? 0)" />
                </div>
            </div>

            <!-- Score Display -->
            <div class="eval-score-box">
                <div class="score-display">
                    <strong>Điểm tổng kết:</strong>
                    <span id="finalScore">@(Model.CompanyEvaluation?.Score ?? 0)/10</span>
                </div>
                <small>(Trung bình cộng của 3 tiêu chí)</small>
            </div>
        </div>

        <!-- Comments Section -->
        <div class="report-section">
            <h5>Nhận xét khác</h5>
            <textarea id="comments" name="comments" class="form-control-custom" rows="6" placeholder="Nhập nhận xét chi tiết về sinh viên...">@(Model.CompanyEvaluation?.Comments ?? "")</textarea>
        </div>

        <!-- Previous Evaluation Notice -->
        @if (Model.CompanyEvaluation != null)
        {
            <div class="alert alert-info">
                Bạn đã đánh giá trước đây vào: <strong>@Model.CompanyEvaluation.EvaluationDate.ToString("dd/MM/yyyy")</strong> — Lưu sẽ cập nhật đánh giá.
            </div>
        }

        <!-- Action Buttons -->
        <div class="eval-actions">
            <a href="@Url.Action("InternList")" class="btn btn-outline-secondary uniform-btn">
                Quay lại
            </a>
            <button type="submit" class="btn btn-success uniform-btn">
                @(Model.CompanyEvaluation != null ? "Cập nhật đánh giá" : "Lưu đánh giá")
            </button>
        </div>
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const criteriaInputs = document.querySelectorAll('.criteria-input');
    const finalScoreSpan = document.getElementById('finalScore');

    function updateFinalScore() {
        let total = 0;
        let count = 0;

        criteriaInputs.forEach(input => {
            const value = parseFloat(input.value) || 0;
            total += value;
            count++;
        });

        const average = count > 0 ? total / count : 0;
        const roundedScore = Math.round(average);
        finalScoreSpan.textContent = roundedScore + '/10';
    }

    criteriaInputs.forEach(input => input.addEventListener('input', updateFinalScore));

    updateFinalScore();
});
</script>

<style>
    .eval-student-card {
        background: #fff;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
        transition: all 0.3s ease;
    }

    .eval-student-card:hover {
        border-color: #28a745;
    }

    .eval-student-info {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .eval-student-avatar {
        width: 70px;
        height: 70px;
        border-radius: 12px;
        overflow: hidden;
        background: linear-gradient(135deg, #28a745, #20c997);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .eval-student-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .eval-student-avatar span {
        color: white;
        font-weight: 700;
        font-size: 1.8rem;
    }

    .eval-student-details h3 {
        margin: 0 0 8px 0;
        color: #333;
        font-size: 1.2rem;
        font-weight: 600;
    }

    .eval-meta {
        display: flex;
        gap: 15px;
        color: #6c757d;
        font-size: 0.9rem;
        margin-top: 5px;
    }

    .eval-status {
        margin-top: 8px;
    }

    .eval-form {
        margin-top: 20px;
    }

    .report-section {
        background: #fff;
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .report-section h5 {
        color: #28a745;
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0 0 15px 0;
        padding-bottom: 8px;
        border-bottom: 2px solid #28a745;
    }

    .criteria-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .criteria-item {
        display: flex;
        flex-direction: column;
    }

    .criteria-item label {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
        font-size: 0.95rem;
    }

    .criteria-item input {
        padding: 8px 10px;
        border: 2px solid #e9ecef;
        border-radius: 5px;
        font-size: 0.85rem;
        transition: border-color 0.3s ease;
        height: auto;
    }

    .criteria-item input:focus {
        outline: none;
        border-color: #28a745;
        box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.1);
    }

    .criteria-item small {
        color: #6c757d;
        font-size: 0.8rem;
        margin-top: 4px;
    }

    .eval-score-box {
        background: #f0f7f4;
        border: 2px solid #20c997;
        border-radius: 6px;
        padding: 10px 12px;
        text-align: center;
    }

    .score-display {
        font-size: 0.95rem;
        font-weight: 600;
        color: #28a745;
    }

    .score-display span {
        font-size: 1.2rem;
        font-weight: 800;
        color: #28a745;
        margin-left: 8px;
    }

    .eval-score-box small {
        display: block;
        color: #6c757d;
        font-size: 0.8rem;
        margin-top: 4px;
    }

    .form-control-custom {
        width: 100%;
        padding: 12px 14px;
        border: 2px solid #e9ecef;
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        resize: vertical;
    }

    .form-control-custom:focus {
        outline: none;
        border-color: #28a745;
        box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.1);
    }

    .alert {
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid #0c63e4;
        background-color: #cfe2ff;
        color: #084298;
        margin-bottom: 20px;
    }

    .alert strong {
        font-weight: 600;
    }

    .eval-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .btn {
        padding: 10px 20px;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .uniform-btn {
        padding: 8px 16px;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-success {
        background-color: #28a745;
        color: white;
        border: 1px solid #28a745;
    }

    .btn-success:hover {
        background-color: #218838;
        border-color: #1e7e34;
    }

    .btn-outline-secondary {
        background-color: transparent;
        color: #6c757d;
        border: 1px solid #6c757d;
    }

    .btn-outline-secondary:hover {
        background-color: #6c757d;
        color: white;
    }

    .status-text {
        font-weight: 600;
        font-size: 0.95rem;
    }

    .status-text.pending {
        color: #ff9800;
    }

    .status-text.approved {
        color: #28a745;
    }

    .status-text.rejected {
        color: #dc3545;
    }

    @@media (max-width: 768px) {
        .eval-student-info {
            flex-direction: column;
            align-items: flex-start;
        }

        .criteria-grid {
            grid-template-columns: 1fr;
        }

        .eval-actions {
            flex-direction: column;
        }

        .eval-actions .btn {
            width: 100%;
        }
    }
</style>