@model List<DoAn_Web.Models.WeeklyReport>

<div class="container mt-4 admin-container">
    <h3 style="margin-bottom:0.6rem;">Báo cáo thực tập của sinh viên: @ViewBag.StudentName (@ViewBag.StudentCode)</h3>

    @if (Model != null && Model.Any())
    {
        <div style="display:flex; flex-direction:column; gap:.6rem; margin-top:.6rem;">
            @foreach (var report in Model.OrderByDescending(r => r.WeekNumber))
            {
                <details class="report-card" style="padding:.75rem;">
                    <summary class="report-header">
                        <div style="display:flex; gap:1rem; align-items:center; width:100%;">
                            <div>
                                <div class="report-week">Tuần @report.WeekNumber</div>
                                <div class="report-date">@report.ReportDate.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div style="margin-left:auto;">
                                @switch ((report.Status ?? "").ToLower())
                                {
                                    case "approved":
                                        <span class="status-pill submitted">Đã duyệt</span>
                                        break;
                                    case "rejected":
                                        <span class="status-pill rejected">Từ chối</span>
                                        break;
                                    default:
                                        <span class="status-pill pending">Chờ duyệt</span>
                                        break;
                                }
                            </div>
                        </div>
                    </summary>

                    <div style="margin-top:.6rem;">
                        <div class="report-content">@report.Content</div>

                        <div style="margin-top:.6rem; display:flex; gap:.5rem; align-items:center;">
                            <a href="@Url.Action("ViewReport", "Internship", new { reportId = report.ReportId })" class="uniform-btn">Xem chi tiết</a>
                            @if (report.ReviewedAt.HasValue)
                            {
                                <div style="color:#6c757d; font-size:.9rem;">Duyệt lúc: @report.ReviewedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                        </div>
                    </div>
                </details>
            }
        </div>
    }
    else
    {
        <div class="evaluation-empty" style="margin-top:.6rem;">Sinh viên chưa nộp báo cáo nào.</div>
    }

    <div style="margin-top:1rem;">
        <a href="@Url.Action("InternList")" class="uniform-btn">← Quay lại danh sách</a>
    </div>
</div>

<style>
    details.report-card { cursor: pointer; }
    details[open] summary { background: #f8fbff; border-radius:8px; }
    summary.report-header { list-style: none; outline: none; }
    summary.report-header::-webkit-details-marker { display:none; }
</style>