@model IEnumerable<DoAn_Web.Models.JobPosting>

<div class="account-management-container">
	<h2 class="account-management-title">
		<div>Danh sách việc làm</div>
	</h2>

	<style>
		/* CSS cho bảng trong trang Danh sách việc làm */
		.job-list-table {
			table-layout: fixed !important;
			width: 100% !important;
			border-collapse: collapse !important;
		}

		.job-list-table th {
			padding: 12px 8px !important;
			text-align: left !important;
			vertical-align: middle !important;
			background-color: #f8f9fa !important;
			font-weight: 600 !important;
			overflow: hidden !important;
			text-overflow: ellipsis !important;
			white-space: nowrap !important;
		}

		.job-list-table td {
			padding: 12px 8px !important;
			text-align: left !important;
			vertical-align: middle !important;
			overflow: hidden !important;
			text-overflow: ellipsis !important;
			white-space: nowrap !important;
		}

		.job-list-table tbody tr {
			height: 60px !important;
		}

		.job-list-table th:nth-child(1),
		.job-list-table td:nth-child(1) {
			width: 15% !important;
		}

		.job-list-table th:nth-child(2),
		.job-list-table td:nth-child(2) {
			width: 15% !important;
		}

		.job-list-table th:nth-child(3),
		.job-list-table td:nth-child(3) {
			width: 35% !important;
		}

		.job-list-table th:nth-child(4),
		.job-list-table td:nth-child(4) {
			width: 15% !important;
		}

		.job-list-table th:nth-child(5),
		.job-list-table td:nth-child(5) {
			width: 20% !important;
			text-align: center !important;
		}

		.job-list-table td:nth-child(5) {
			white-space: normal !important;
			overflow: visible !important;
		}

		.job-list-table .action-buttons {
			display: inline-flex !important;
			align-items: center !important;
			gap: 8px !important;
			justify-content: center !important;
		}

		.job-list-table .action-buttons .btn {
			margin: 0 !important;
			white-space: nowrap !important;
		}
	</style>

	@{
		var activeJobs = ViewBag.ActiveJobs as List<DoAn_Web.Models.JobPosting>;
		var expiredJobs = ViewBag.ExpiredJobs as List<DoAn_Web.Models.JobPosting>;
	}

	@if ((activeJobs == null || !activeJobs.Any()) && (expiredJobs == null || !expiredJobs.Any()))
	{
		<p>Chưa có công việc nào được đăng.</p>
	}
	else
	{
		@* Phần công việc còn hạn nộp *@
		@if (activeJobs != null && activeJobs.Any())
		{
			<div style="margin-bottom: 40px;">
				<h3 style="color: #28a745; font-weight: 600; font-size: 1.2rem; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #28a745;">
					Công việc còn hạn nộp (@activeJobs.Count)
				</h3>
				<table class="table table-bordered job-list-table">
					<thead>
						<tr>
							<th>Tiêu đề</th>
							<th>Công ty</th>
							<th>Mô tả</th>
							<th>Ngày đăng</th>
							<th>Hành động</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var job in activeJobs)
						{
							<tr>
								<td title="@job.Title">@job.Title</td>
								<td title="@job.Company.Name">@job.Company.Name</td>
								<td title="@job.Description">@job.Description</td>
								<td>@(job.CreatedAt.HasValue ? job.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</td>
								<td>
									<div class="action-buttons">
										<a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.JobId" class="btn btn-primary uniform-btn">Xem chi tiết</a>
										@if (Context.Session.GetInt32("StudentId") != null)
										{
											<a asp-controller="Applications" asp-action="ApplyJob" asp-route-jobId="@job.JobId" class="btn btn-custom uniform-btn">Ứng tuyển</a>
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}

		@* Phần công việc hết hạn nộp *@
		@if (expiredJobs != null && expiredJobs.Any())
		{
			<div>
				<h3 style="color: #6c757d; font-weight: 600; font-size: 1.2rem; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #6c757d;">
					Công việc hết hạn nộp (@expiredJobs.Count)
				</h3>
				<table class="table table-bordered job-list-table job-list-table-expired">
					<thead>
						<tr>
							<th>Tiêu đề</th>
							<th>Công ty</th>
							<th>Mô tả</th>
							<th>Ngày đăng</th>
							<th>Hành động</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var job in expiredJobs)
						{
							<tr style="opacity: 0.7;">
								<td title="@job.Title">@job.Title</td>
								<td title="@job.Company.Name">@job.Company.Name</td>
								<td title="@job.Description">@job.Description</td>
								<td>@(job.CreatedAt.HasValue ? job.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</td>
								<td>
									<div class="action-buttons">
										<a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.JobId" class="btn btn-secondary uniform-btn">Xem chi tiết</a>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
</div>