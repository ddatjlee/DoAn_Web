@model DoAn_Web.Models.Internship

@{
    ViewData["Title"] = "Báo cáo thực tập hàng tuần";
}

<div class="application-list-container">
    <h2 class="company-profile-title">Báo cáo thực tập hàng tuần</h2>

    <div class="card mb-4">

        <div class="card-body">
            <p><strong>Sinh viên:</strong> @Model.Student.FullName</p>
            <p><strong>Công ty:</strong> @Model.Company.Name</p>
            <p><strong>Giảng viên hướng dẫn:</strong> @Model.Supervisor.Name</p>
            <p><strong>Thời gian:</strong> @Model.StartDate.ToString("dd/MM/yyyy") - @(Model.EndDate?.ToString("dd/MM/yyyy") ?? "Hiện tại")</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h4>Đưa Báo cáo Thực Tập</h4>
        </div>
        <div class="card-body">
            <div style="margin-bottom: 20px;">
                @if (!string.IsNullOrEmpty(Model.InternshipReportUrl))
                {
                    <div style="padding: 12px; background: #d4edda; border: 1px solid #c3e6cb; border-radius: 6px; margin-bottom: 16px;">
                        <p style="margin: 0; color: #155724;">
                            <i class="fas fa-check-circle"></i> Báo cáo thực tập đã được gửi
                        </p>
                        <p style="margin: 8px 0 0 0;">
                            <a href="@Model.InternshipReportUrl" target="_blank" class="btn btn-sm btn-outline-primary">Tậi xuống Báo cáo</a>
                        </p>
                    </div>
                }
                else
                {
                    <form id="internshipReportForm" enctype="multipart/form-data" method="post" asp-action="UploadInternshipReport" asp-controller="Internship">
                        <input type="hidden" name="internshipId" value="@Model.InternshipId" />
                        <div style="margin-bottom: 16px;">
                            <label for="reportFile" style="display: block; margin-bottom: 8px; font-weight: 500;">Chọn file báo cáo (.pdf, .docx, .doc):</label>
                            <input type="file" id="reportFile" name="reportFile" accept=".pdf,.doc,.docx" required style="padding: 8px; border: 1px solid #ddd; border-radius: 6px; width: 100%;" />
                            <small style="color: #6c757d; display: block; margin-top: 6px;">Chỉ chấp nhận các tệp: PDF, Word (.doc, .docx)</small>
                        </div>
                        <button type="submit" class="uniform-btn btn-primary">Gửi Báo cáo</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4>Bảng báo cáo công việc</h4>
            <button type="button" class="uniform-btn btn-primary" id="btnSaveAll">Lưu tất cả</button>
        </div>
        <div class="card-body">
            <div class="weekly-report-list" id="weeklyReportList">
                @{
                    // Tính số tuần dựa trên StartDate -> EndDate, nếu không có EndDate thì mặc định 8 tuần
                    var totalWeeks = 8;
                    if (Model.EndDate.HasValue && Model.EndDate.Value > Model.StartDate)
                    {
                        var totalDays = (Model.EndDate.Value.Date - Model.StartDate.Date).TotalDays + 1; // tính bao gồm cả ngày đầu/cuối
                        totalWeeks = Math.Max(1, (int)Math.Ceiling(totalDays / 7.0));
                    }

                    for (int i = 1; i <= totalWeeks; i++)
                    {
                        var report = Model.WeeklyReports.FirstOrDefault(r => r.WeekNumber == i);
                        var content = report?.Content ?? "";
                        var submitted = report != null;
                        var startDate = Model.StartDate.AddDays((i-1) * 7);
                        var endDate = startDate.AddDays(6);
                        if (Model.EndDate.HasValue && endDate > Model.EndDate.Value)
                        {
                            endDate = Model.EndDate.Value;
                        }

                        <div class="weekly-row" data-week="@i">
                            <div class="week-col">
                                <strong>Tuần @i</strong>
                                <small>@startDate.ToString("dd/MM") - @endDate.ToString("dd/MM")</small>
                            </div>
                            <div class="content-col">
                                <textarea class="report-content" data-week="@i" @(submitted ? "readonly" : "")>@content</textarea>
                            </div>
                            <div class="status-col">
                                @if (submitted)
                                {
                                    <div class="status-pill submitted"><i class="fas fa-check"></i> Đã nộp</div>
                                }
                                else
                                {
                                    <div class="status-pill pending"><i class="fas fa-hourglass-half"></i> Chưa nộp</div>
                                    <div style="margin-top:.6rem">
                                        <button class="uniform-btn btn-primary btn-save-report" data-week="@i">Nộp</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            function submitReport(week, content, btn) {
                if (!content) {
                    alert('Vui lòng nhập nội dung báo cáo!');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("SubmitReport", "Internship")',
                    type: 'POST',
                    data: {
                        weekNumber: week,
                        content: content,
                        internshipId: @Model.InternshipId
                    },
                    success: function(response) {
                        if (response.success) {
                            var row = $(`.weekly-row[data-week="${week}"]`);
                            row.find('.status-col').html('<div class="status-pill submitted"><i class="fas fa-check"></i> Đã nộp</div>');
                            row.find('textarea.report-content').prop('readonly', true);
                            if (btn) btn.remove();
                        } else {
                            alert(response.message || 'Có lỗi xảy ra, vui lòng thử lại!');
                        }
                    },
                    error: function() {
                        alert('Có lỗi xảy ra, vui lòng thử lại!');
                    }
                });
            }

            $(document).on('click', '.btn-save-report', function() {
                var btn = $(this);
                var week = btn.data('week');
                var content = $(`.report-content[data-week="${week}"]`).val();
                submitReport(week, content, btn);
            });

            $('#btnSaveAll').click(function() {
                var buttons = $('.btn-save-report').toArray();
                function next() {
                    if (buttons.length === 0) {
                        alert('Đã lưu tất cả báo cáo có thể nộp.');
                        return;
                    }
                    var btn = $(buttons.shift());
                    var week = btn.data('week');
                    var content = $(`.report-content[data-week="${week}"]`).val();
                    submitReport(week, content, btn);
                    setTimeout(next, 300);
                }
                next();
            });
        });
    </script>
}