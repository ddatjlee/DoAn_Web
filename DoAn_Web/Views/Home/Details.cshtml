@model DoAn_Web.Models.JobPosting

@{
    ViewData["Title"] = "Chi tiết công việc";
}

<div class="account-management-container">
    <div class="account-management-title">
        <div>
            <h2 class="job-title">@Model.Title</h2>
            <p class="job-company"><i class="fas fa-building"></i> @Model.Company.Name</p>
        </div>
        <div class="job-deadline">
            <span class="label">Hạn nộp</span>
            <span class="value">@Model.ApplicationDeadline.ToString("dd/MM/yyyy")</span>
        </div>
    </div>

    <div class="job-info-grid">
        <div class="info-row">
            <span class="label">Mức lương</span>
            <span class="value">@Model.SalaryRange</span>
        </div>
        <div class="info-row">
            <span class="label">Địa điểm</span>
            <span class="value">@(Model.Location != null ? $"{Model.Location.City}, {Model.Location.Country}" : "Không xác định")</span>
        </div>
        <div class="info-row">
            <span class="label">Loại công việc</span>
            <span class="value">@Model.JobType.Name</span>
        </div>
        <div class="info-row">
            <span class="label">Kinh nghiệm</span>
            <span class="value">@Model.Level.Name</span>
        </div>
        <div class="info-row">
            <span class="label">Số lượng tuyển</span>
            <span class="value">@Model.Vacancies</span>
        </div>
    </div>

    <div class="job-section">
        <h5><i class="fas fa-info-circle"></i> Mô tả công việc</h5>
        <p>@Model.Description</p>
    </div>

    <div class="job-section">
        <h5><i class="fas fa-tasks"></i> Yêu cầu</h5>
        <p>@Model.Requirements</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Benefits))
    {
        <div class="job-section">
            <h5><i class="fas fa-gift"></i> Lợi ích</h5>
            <p>@Model.Benefits</p>
        </div>
    }

    <div class="job-actions">
        @if (Context.Session.GetInt32("StudentId") != null)
        {
            <a asp-controller="Applications" asp-action="ApplyJob" asp-route-jobId="@Model.JobId" class="btn btn-success">Ứng tuyển ngay</a>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</div>

<style>
    .account-management-container {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        max-width: 900px;
        margin: 0 auto;
    }

    .account-management-title {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 20px;
    }

    .job-title {
        margin: 0;
        font-size: 1.6rem;
        font-weight: 700;
        color: #ff6f61;
    }

    .job-company {
        margin: 6px 0 0 0;
        color: #28a745;
        font-weight: 600;
    }

    .job-company i { margin-right: 6px; }

    .job-deadline {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 12px 16px;
        min-width: 160px;
        text-align: center;
    }

    .job-deadline .label {
        display: block;
        color: #6c757d;
        font-size: 0.75rem;
    }

    .job-deadline .value {
        display: block;
        font-weight: 600;
        color: #212529;
        margin-top: 4px;
        font-size: 0.95rem;
    }

    .job-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .info-row {
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 12px;
        background: #fdfefe;
    }

    .info-row .label {
        display: block;
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 4px;
    }

    .info-row .value {
        display: block;
        font-weight: 600;
        color: #212529;
    }

    .job-section {
        margin-top: 16px;
        padding: 14px;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        background: #fff;
    }

    .job-section h5 {
        margin: 0 0 8px 0;
        font-size: 1.05rem;
        color: #28a745;
        font-weight: 700;
    }

    .job-section h5 i { margin-right: 6px; }

    .job-section p {
        margin: 0;
        color: #343a40;
        line-height: 1.5;
    }

    .job-actions {
        margin-top: 20px;
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: nowrap;
    }

    .job-actions .btn {
        white-space: nowrap;
        padding: 0.75rem 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 8px;
    }

    .btn-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border: none;
    }

    .btn-success:hover { filter: brightness(0.95); }

    @@media (max-width: 576px) {
        .account-management-title { flex-direction: column; }
        .job-deadline { width: 100%; }
    }
</style>
