<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DoAn_Web</title>

    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Icon pass -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <!-- File CSS của bạn -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DoAn_Web.styles.css" asp-append-version="true" />

    <!-- CSS tùy chỉnh cho background header -->
    <style>
        /* Header với background */
        .header-section {
            background-image: url('/images/OIP.jpg'); /* Đường dẫn đến hình ảnh background */
            background-size: cover;
            background-position: center;
            padding: 50px 0;
            color: white;
            text-align: center;
            position: relative;
        }

        /* Nếu bạn muốn dùng gradient thay vì hình ảnh */
        .header-section.gradient-bg {
            background: linear-gradient(90deg, #1a3c34 0%, #2e6a5c 100%);
        }

        /* Overlay để làm mờ background (tùy chọn) */
        .header-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5); /* Overlay tối để chữ trắng dễ đọc */
        }

        /* Đảm bảo nội dung trong header nằm trên overlay */
        .header-content {
            position: relative;
            z-index: 1;
        }

        /* Search bar */
        .search-bar {
            max-width: 600px;
            margin: 0 auto;
        }

        .search-bar input {
            padding: 10px;
            border-radius: 5px 0 0 5px;
            border: none;
        }

        .search-bar button {
            padding: 10px 20px;
            border-radius: 0 5px 5px 0;
            background-color: #007bff;
            border: none;
        }

        /* Phần nội dung chính (không có background) */
        .content-section {
            padding: 30px 0;
            background-color: #f8f9fa; /* Nền trắng nhạt */
        }
    </style>
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-light shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">DoAn_Web</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse fw-bold" id="navbarNav">
                <ul class="navbar-nav me-auto fw-bold">
                    <li class="nav-item fw-bold">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Jobs" asp-action="Index">Việc làm</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Companies" asp-action="Index">Công ty</a>
                    </li>
                </ul>

                <!-- Hiển thị menu đăng nhập/đăng xuất -->
                <ul class="navbar-nav fw-bold">
                    @if (Context.Session.GetString("UserEmail") != null)
                    {
                            <li class="nav-item fw-bold">
                                <span class="navbar-text text-dark me-3">Chào @Context.Session.GetString("UserName")</span>
                            </li>
                            <li class="nav-item fw-bold">
                                <a class="btn btn-outline-light btn-sm" asp-controller="Home" asp-action="Logout">Đăng xuất</a>
                            </li>
                    }
                    else
                    {
                            <li class="nav-item fw-bold">
                                <a class="btn btn-outline-light btn-sm" asp-controller="Home" asp-action="Login">Đăng nhập</a>
                                <a class="btn btn-outline-light btn-sm" asp-controller="Home" asp-action="Register">Đăng kí</a>
                            </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Header với Background (render từ view) -->
    @RenderSection("Header", required: false)

    <div class="container">
        <main role="main" class="content-section">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            © 2025 - DoAn_Web
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>