@model IEnumerable<DoAn_Web.Models.Internship>

<div class="container mt-4">
    <h2>Danh sách báo cáo thực tập của sinh viên</h2>

    @foreach (var internship in Model)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h4>@internship.Student.FullName</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Công ty:</strong> @internship.Company.Name</p>
                        <p><strong>Thời gian:</strong> @internship.StartDate.ToString("dd/MM/yyyy") - @(internship.EndDate?.ToString("dd/MM/yyyy") ?? "Hiện tại")</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Số báo cáo:</strong> @internship.WeeklyReports.Count</p>
                        <p><strong>Trạng thái:</strong> @internship.Status</p>
                    </div>
                </div>

                <div class="accordion" id="reportAccordion@(internship.InternshipId)">
                    @foreach (var report in internship.WeeklyReports.OrderByDescending(r => r.WeekNumber))
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading@(report.ReportId)">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" 
                                        data-bs-target="#collapse@(report.ReportId)">
                                    Tuần @report.WeekNumber - @report.ReportDate.ToString("dd/MM/yyyy")
                                    @switch (report.Status?.ToLower())
                                    {
                                        case "approved":
                                            <span class="badge bg-success ms-2">Đã duyệt</span>
                                            break;
                                        case "rejected":
                                            <span class="badge bg-danger ms-2">Từ chối</span>
                                            break;
                                        default:
                                            <span class="badge bg-warning ms-2">Chờ duyệt</span>
                                            break;
                                    }
                                </button>
                            </h2>
                            <div id="collapse@(report.ReportId)" class="accordion-collapse collapse" 
                                 data-bs-parent="#reportAccordion@(internship.InternshipId)">
                                <div class="accordion-body">
                                    <pre class="report-content mb-3">@report.Content</pre>
                                    @if (report.Status?.ToLower() == "approved")
                                    {
                                        <div class="alert alert-success">
                                            <strong>Nhận xét:</strong> @report.SupervisorComment
                                            <br />
                                            <strong>Duyệt lúc:</strong> @report.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    }
                                    else if (report.Status?.ToLower() == "rejected")
                                    {
                                        <div class="alert alert-danger">
                                            <strong>Lý do từ chối:</strong> @report.SupervisorComment
                                            <br />
                                            <strong>Từ chối lúc:</strong> @report.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("ReviewReport", "Supervisor", new { reportId = report.ReportId })" 
                                           class="btn btn-primary">
                                            Xem & Duyệt báo cáo
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .report-content {
        white-space: pre-wrap;
        font-family: inherit;
        margin: 0;
        padding: 10px;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
    }
    
    .accordion-button:not(.collapsed) {
        background-color: #e7f1ff;
    }
</style>