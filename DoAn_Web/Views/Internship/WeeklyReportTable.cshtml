@model DoAn_Web.Models.Internship

@{
    ViewData["Title"] = "Báo cáo thực tập hàng tuần";
}

<div class="application-list-container">
    <h2 class="company-profile-title">Báo cáo thực tập hàng tuần</h2>

    <div class="card mb-4">

        <div class="card-body">
            <p><strong>Sinh viên:</strong> @Model.Student.FullName</p>
            <p><strong>Công ty:</strong> @Model.Company.Name</p>
            <p><strong>Giảng viên hướng dẫn:</strong> @Model.Supervisor.Name</p>
            <p><strong>Thời gian:</strong> @Model.StartDate.ToString("dd/MM/yyyy") - @(Model.EndDate?.ToString("dd/MM/yyyy") ?? "Hiện tại")</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4>Bảng báo cáo công việc</h4>
            <button type="button" class="uniform-btn btn-primary" id="btnSaveAll">Lưu tất cả</button>
        </div>
        <div class="card-body">
            <div class="weekly-report-list" id="weeklyReportList">
                @{
                    var totalWeeks = 8; // Số tuần thực tập mặc định
                    for (int i = 1; i <= totalWeeks; i++)
                    {
                        var report = Model.WeeklyReports.FirstOrDefault(r => r.WeekNumber == i);
                        var content = report?.Content ?? "";
                        var submitted = report != null;
                        var startDate = Model.StartDate.AddDays((i-1) * 7);
                        var endDate = startDate.AddDays(6);

                        <div class="weekly-row" data-week="@i">
                            <div class="week-col">
                                <strong>Tuần @i</strong>
                                <small>@startDate.ToString("dd/MM") - @endDate.ToString("dd/MM")</small>
                            </div>
                            <div class="content-col">
                                <textarea class="report-content" data-week="@i" @(submitted ? "readonly" : "")>@content</textarea>
                            </div>
                            <div class="status-col">
                                @if (submitted)
                                {
                                    <div class="status-pill submitted"><i class="fas fa-check"></i> Đã nộp</div>
                                }
                                else
                                {
                                    <div class="status-pill pending"><i class="fas fa-hourglass-half"></i> Chưa nộp</div>
                                    <div style="margin-top:.6rem">
                                        <button class="uniform-btn btn-primary btn-save-report" data-week="@i">Nộp</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            function submitReport(week, content, btn) {
                if (!content) {
                    alert('Vui lòng nhập nội dung báo cáo!');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("SubmitReport", "Internship")',
                    type: 'POST',
                    data: {
                        weekNumber: week,
                        content: content,
                        internshipId: @Model.InternshipId
                    },
                    success: function(response) {
                        if (response.success) {
                            var row = $(`.weekly-row[data-week="${week}"]`);
                            row.find('.status-col').html('<div class="status-pill submitted"><i class="fas fa-check"></i> Đã nộp</div>');
                            row.find('textarea.report-content').prop('readonly', true);
                            if (btn) btn.remove();
                        } else {
                            alert(response.message || 'Có lỗi xảy ra, vui lòng thử lại!');
                        }
                    },
                    error: function() {
                        alert('Có lỗi xảy ra, vui lòng thử lại!');
                    }
                });
            }

            $(document).on('click', '.btn-save-report', function() {
                var btn = $(this);
                var week = btn.data('week');
                var content = $(`.report-content[data-week="${week}"]`).val();
                submitReport(week, content, btn);
            });

            $('#btnSaveAll').click(function() {
                var buttons = $('.btn-save-report').toArray();
                function next() {
                    if (buttons.length === 0) {
                        alert('Đã lưu tất cả báo cáo có thể nộp.');
                        return;
                    }
                    var btn = $(buttons.shift());
                    var week = btn.data('week');
                    var content = $(`.report-content[data-week="${week}"]`).val();
                    submitReport(week, content, btn);
                    setTimeout(next, 300);
                }
                next();
            });
        });
    </script>
}