@model IEnumerable<DoAn_Web.Models.JobPosting>

<h2>Quản lý bài đăng tuyển dụng</h2>

@if (TempData["SuccessMessage"] != null)
{
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Tiêu đề</th>
            <th>Công ty</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model)
        {
                <tr>
                    <td>
                        <a href="@Url.Action("Details", "Jobs", new { id = job.JobId })">@job.Title</a>
                    </td>
                    <td>@job.Company.Name</td>
                    <td>
                    @if (job.IsApproved == false)
                    {
                                <span class="badge bg-warning">Chưa duyệt</span>
                    }
                    else
                    {
                                <span class="badge bg-success">Đã duyệt</span>
                    }
                    </td>
                    <td>
                    @if (job.IsApproved == false)
                    {
                                <form method="post" asp-action="ApproveJob" asp-route-jobId="@job.JobId">
                                    <button type="submit" class="btn btn-success">Duyệt</button>
                                </form>
                    }
                    else
                    {
                                <span class="badge bg-info">Đã duyệt</span>
                    }
                    </td>
                </tr>
        }
    </tbody>
</table>
