@model List<DoAn_Web.Models.WeeklyReport>

<div class="account-management-container">
    <h2 class="account-management-title">Báo cáo thực tập: @ViewBag.StudentName (@ViewBag.StudentCode)</h2>

    <div class="overall-report-box">
        @if (!string.IsNullOrEmpty(ViewBag.InternshipReportUrl as string))
        {
            <div class="overall-report-row">
                <div class="overall-report-text">
                    <strong>Báo cáo thực tập (tổng)</strong>
                    <span>File đã được sinh viên nộp.</span>
                </div>
                <a href="@ViewBag.InternshipReportUrl" target="_blank" class="btn btn-success uniform-btn overall-report-btn">Tải báo cáo</a>
            </div>
        }
        else
        {
            <div class="overall-report-row empty">
                <div class="overall-report-text">
                    <strong>Báo cáo thực tập (tổng)</strong>
                    <span>Chưa có file được nộp.</span>
                </div>
            </div>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Tuần</th>
                        <th>Ngày báo cáo</th>
                        <th>Nội dung (tóm tắt)</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model.OrderBy(r => r.WeekNumber))
                    {
                        <tr>
                            <td>
                                <strong>Tuần @report.WeekNumber</strong>
                            </td>
                            <td>@report.ReportDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="report-summary">@((report.Content?.Length > 100) ? report.Content.Substring(0, 100) + "..." : report.Content)</span>
                            </td>
                            <td>
                                @switch ((report.Status ?? "").ToLower())
                                {
                                    case "approved":
                                        <span class="status-text approved">Đã duyệt</span>
                                        break;
                                    case "rejected":
                                        <span class="status-text rejected">Từ chối</span>
                                        break;
                                    default:
                                        <span class="status-text pending">Chờ duyệt</span>
                                        break;
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("ViewReport", "Internship", new { reportId = report.ReportId })" class="btn btn-info uniform-btn btn-sm">
                                    <i class="fas fa-eye"></i> Xem chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Sinh viên chưa nộp báo cáo nào.
        </div>
    }

    <div style="margin-top: 20px; text-align: center;">
        <a href="@Url.Action("InternList")" class="btn btn-outline-secondary" style="padding: 10px 20px; font-weight: 600; border-radius: 8px; white-space: nowrap;">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách
        </a>
    </div>
</div>

<style>
    .report-summary {
        color: #495057;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .account-management-container .table {
        table-layout: auto;
        width: 100%;
    }

    .account-management-container .table th:nth-child(1) {
        width: 12%;
    }

    .account-management-container .table th:nth-child(2) {
        width: 12%;
    }

    .account-management-container .table th:nth-child(3) {
        width: 40%;
    }

    .account-management-container .table th:nth-child(4) {
        width: 12%;
    }

    .account-management-container .table th:nth-child(5) {
        width: 24%;
    }

    .table-responsive {
        overflow-x: hidden;
    }

    .status-text {
        font-weight: 600;
        font-size: 0.95rem;
    }

    .status-text.pending {
        color: #ff9800;
    }

    .status-text.approved {
        color: #28a745;
    }

    .status-text.rejected {
        color: #dc3545;
    }

    .overall-report-box {
        margin: 15px 0 25px;
        padding: 14px 16px;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        background: #fdfefc;
    }

    .overall-report-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .overall-report-row.empty {
        color: #6c757d;
    }

    .overall-report-text {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .overall-report-text strong {
        color: #28a745;
    }

    .overall-report-btn {
        min-width: 140px;
    }
</style>