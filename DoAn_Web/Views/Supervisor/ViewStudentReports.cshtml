@model List<DoAn_Web.Models.WeeklyReport>

<div class="container mt-4 admin-container">
    <h2 style="margin-bottom:1rem;">Báo cáo thực tập của sinh viên: <span style="color:#2c3e50;">@ViewBag.StudentName</span></h2>

    @if (Model != null && Model.Any())
    {
        <div class="weekly-report-list">
            @foreach (var report in Model.OrderBy(r => r.WeekNumber))
            {
                <div class="weekly-row">
                    <div class="week-col">
                        <strong>Tuần @report.WeekNumber</strong>
                        <small>@report.ReportDate.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>

                    <div class="content-col">
                        <div style="font-weight:700; color:#343a40; margin-bottom:.25rem;">Tóm tắt báo cáo</div>
                        <div style="color:#495057;">@((report.Content?.Length > 220) ? report.Content.Substring(0,220) + "..." : report.Content)</div>
                    </div>

                    <div class="status-col">
                        @switch (report.Status?.ToLower())
                        {
                            case "pending":
                                <span class="status-pill pending">Chờ duyệt</span>
                                break;
                            case "approved":
                                <span class="status-pill submitted">Đã duyệt</span>
                                break;
                            case "rejected":
                                <span class="status-pill rejected">Từ chối</span>
                                break;
                            default:
                                <span class="status-pill">@report.Status</span>
                                break;
                        }
                        <div style="margin-top:.6rem;">
                            <a href="@Url.Action("ReviewReport", "Supervisor", new { reportId = report.ReportId })" class="btn btn-primary btn-sm uniform-btn">
                                <i class="fas fa-eye"></i> Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="evaluation-empty">Sinh viên chưa có báo cáo nào.</div>
    }
</div>

<style>
    /* small scoped tweaks for this page */
    .weekly-report-list { margin-top:.5rem; }
    .weekly-row { align-items:center; }
    .week-col small { display:block; color:#6c757d; margin-top:.25rem; }
</style>