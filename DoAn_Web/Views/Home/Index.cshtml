@model DoAn_Web.Models.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ";
}

@section Header {
        <section class="header-section">
            <div class="header-content">
                <h3 class="text-center">Chào mừng đến với trang tuyển dụng!</h3>
                <!-- Khung tìm kiếm công ty -->
                <div class="search-bar mt-4">
                    <form class="d-flex" asp-controller="Home" asp-action="SearchCompany" method="get">
                        <input type="text" name="companyName" class="form-control" placeholder="Tìm công ty...">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Tìm kiếm</button>
                    </form>
                </div>
            </div>
        </section>
}

<!-- Nội dung chính -->
<div class="row">
    <!-- Việc làm mới nhất -->
    <h4 class="mt-4">Việc làm mới nhất</h4>
    <div class="row">
        @foreach (var job in Model.Jobs)
        {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm job-card">
                        <div class="card-body">
                            <!-- Hiển thị tên công việc -->
                            <h5 class="card-title">@job.Title</h5>
                            <!-- Hiển thị tên công ty và lương -->
                            <p class="card-text"><strong>@job.Company.Name</strong> - <span class="text-success">@job.SalaryRange</span></p>
                            <!-- Hiển thị địa điểm -->
                            <p class="card-text"><strong>Địa điểm:</strong> @(job.Location != null ? $"{job.Location.City}, {job.Location.Country}" : "Không xác định")</p>
                            <!-- Hiển thị yêu cầu công việc -->
                            <p class="card-text"><strong>Mô tả:</strong> @job.Description</p>
                            <!-- Hiển thị hạn nộp -->
                            <p class="card-text"><small class="text-muted">Hạn nộp: @job.ApplicationDeadline.ToString("dd/MM/yyyy")</small></p>
                            <!-- Nút Xem chi tiết và Ứng tuyển -->
                            <div class="d-flex justify-content-end mt-3">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@job.JobId" class="btn btn-custom job-btn me-2">Xem chi tiết</a>
                            @if (Context.Session.GetInt32("StudentId") != null)
                            {
                                        <a asp-controller="Applications" asp-action="ApplyJob" asp-route-jobId="@job.JobId" class="btn btn-custom job-btn">Ứng tuyển</a>
                            }
                            </div>
                        </div>
                    </div>
                </div>
        }
    </div>

    <!-- Công ty nổi bật -->
    <h4 class="mt-4">Công ty nổi bật</h4>
    <div class="row">
        @foreach (var company in Model.Companies)
        {
                <div class="col-md-3">
                    <div class="card shadow-sm company-card">
                        <img src="/images/@company.LogoUrl" class="card-img-top" alt="@company.Name Logo">
                        <div class="card-body text-center">
                            <h5 class="card-title">@company.Name</h5>
                            <p class="card-text">@company.Address</p>
                            <a href="#" class="btn btn-outline-primary btn-sm">Xem công ty</a>
                        </div>
                    </div>
                </div>
        }
    </div>
</div>