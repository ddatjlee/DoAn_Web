@model DoAn_Web.Models.JobPosting

@{
    ViewData["Title"] = "Đăng tin tuyển dụng";
}

<h2>Đăng tin tuyển dụng</h2>

@if (TempData["SuccessMessage"] != null)
{
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<form asp-action="CreateJob" method="post" class="mt-4">
    <div class="mb-3">
        <label class="form-label">Loại công việc</label>
        <select asp-for="JobTypeId" class="form-control" required>
            <option value="">Chọn loại công việc</option>
            @foreach (var jobType in ViewBag.JobTypes)
            {
                    <option value="@jobType.JobTypeID">@jobType.Name</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Mức độ kinh nghiệm</label>
        <select asp-for="LevelId" class="form-control" required>
            <option value="">Chọn mức độ kinh nghiệm</option>
            @foreach (var level in ViewBag.ExperienceLevels)
            {
                    <option value="@level.LevelID">@level.Name</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Địa điểm</label>
        <select asp-for="LocationId" class="form-control">
            <option value="">Chọn địa điểm</option>
            @foreach (var location in ViewBag.Locations)
            {
                    <option value="@location.LocationID">@location.City, @location.Country</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Tiêu đề</label>
        <input asp-for="Title" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Mô tả</label>
        <textarea asp-for="Description" class="form-control" required></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Yêu cầu</label>
        <textarea asp-for="Requirements" class="form-control" required></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Quyền lợi</label>
        <textarea asp-for="Benefits" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Mức lương</label>
        <input asp-for="SalaryRange" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Hạn nộp đơn</label>
        <input asp-for="ApplicationDeadline" type="date" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Số lượng tuyển</label>
        <input asp-for="Vacancies" type="number" class="form-control" value="1" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Kỹ năng yêu cầu</label>
        <select multiple name="selectedSkills" class="form-control">
            @foreach (var skill in ViewBag.Skills)
            {
                    <option value="@skill.SkillID">@skill.Name</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Đăng tin</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Quay lại</a>
</form>