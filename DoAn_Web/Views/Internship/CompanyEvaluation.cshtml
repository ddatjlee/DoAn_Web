    }

    .legal-basis-item {
        margin-bottom: 20px;
        padding: 15px;
        background: #f8f9fa;
        border-left: 4px solid #28a745;
        border-radius: 6px;
    }

    .legal-basis-item h5 {
        color: #28a745;
        font-weight: 600;
        margin: 0 0 8px 0;
        font-size: 1rem;
    }

    .legal-basis-item p {
        margin: 0;
        color: #495057;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .legal-basis-item .mb-1 {
        margin-bottom: 0.25rem;
    }

    .legal-basis-item .mb-2 {
        margin-bottom: 0.5rem;
    }

    .legal-basis-item .text-muted {
        color: #6c757d !important;
    }

    .legal-basis-item .btn-outline-success {
        color: #28a745;
        border: 1px solid #28a745;
        background: transparent;
        padding: 4px 12px;
        font-size: 0.85rem;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.2s ease;
    }

    .legal-basis-item .btn-outline-success:hover {
