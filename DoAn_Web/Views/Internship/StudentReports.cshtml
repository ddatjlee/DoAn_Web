@model DoAn_Web.Models.Internship

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Thông tin thực tập</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Công ty:</strong> @Model.Company.Name</p>
                            <p><strong>Thời gian:</strong> @Model.StartDate.ToString("dd/MM/yyyy") - @(Model.EndDate?.ToString("dd/MM/yyyy") ?? "Hiện tại")</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Giảng viên hướng dẫn:</strong> @Model.Supervisor.Name</p>
                            <p><strong>Trạng thái:</strong> @Model.Status</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Báo cáo tuần</h4>
                    <a asp-controller="Internship" asp-action="CreateReport" class="btn btn-light">
                        <i class="fas fa-plus"></i> Tạo báo cáo mới
                    </a>
                </div>
                <div class="card-body">
                    @if (!Model.WeeklyReports.Any())
                    {
                        <div class="alert alert-info">
                            Chưa có báo cáo nào. Hãy tạo báo cáo mới!
                        </div>
                    }
                    else
                    {
                        <div class="accordion" id="reportAccordion">
                            @foreach (var report in Model.WeeklyReports.OrderByDescending(r => r.WeekNumber))
                            {
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" 
                                                data-bs-target="#collapse@(report.ReportId)">
                                            <div class="d-flex justify-content-between w-100 align-items-center me-3">
                                                <span>Tuần @report.WeekNumber - @report.ReportDate.ToString("dd/MM/yyyy")</span>
                                                @switch (report.Status?.ToLower())
                                                {
                                                    case "approved":
                                                        <span class="badge bg-success">Đã duyệt</span>
                                                        break;
                                                    case "rejected":
                                                        <span class="badge bg-danger">Từ chối</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-warning">Chờ duyệt</span>
                                                        break;
                                                }
                                            </div>
                                        </button>
                                    </h2>
                                    <div id="collapse@(report.ReportId)" class="accordion-collapse collapse"
                                         data-bs-parent="#reportAccordion">
                                        <div class="accordion-body">
                                            <pre class="report-content mb-3">@report.Content</pre>
                                            @if (!string.IsNullOrEmpty(report.SupervisorComment))
                                            {
                                                <div class="supervisor-comment mt-3 p-3 rounded @(report.Status?.ToLower() == "approved" ? "bg-success-light" : "bg-danger-light")">
                                                    <h5>Nhận xét của giảng viên:</h5>
                                                    <p>@report.SupervisorComment</p>
                                                    <small>Thời gian: @report.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")</small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (Model.SupervisorEvaluation != null)
            {
                <div class="card mt-4">
                    <div class="card-header bg-info text-white">
                        <h4 class="mb-0">Đánh giá của giảng viên</h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Điểm:</strong> @Model.SupervisorEvaluation.Score/100</p>
                                <p><strong>Ngày đánh giá:</strong> @Model.SupervisorEvaluation.EvaluationDate.ToString("dd/MM/yyyy")</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Nhận xét:</strong></p>
                                <p>@Model.SupervisorEvaluation.Comments</p>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.CompanyEvaluation != null)
            {
                <div class="card mt-4">
                    <div class="card-header bg-success text-white">
                        <h4 class="mb-0">Đánh giá của công ty</h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Điểm:</strong> @Model.CompanyEvaluation.Score/100</p>
                                <p><strong>Ngày đánh giá:</strong> @Model.CompanyEvaluation.EvaluationDate.ToString("dd/MM/yyyy")</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Nhận xét:</strong></p>
                                <p>@Model.CompanyEvaluation.Comments</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .report-content {
        white-space: pre-wrap;
        font-family: inherit;
        margin: 0;
        padding: 10px;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
    }
    
    .bg-success-light {
        background-color: #d4edda;
        border: 1px solid #c3e6cb;
    }
    
    .bg-danger-light {
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
    }
    
    .accordion-button:not(.collapsed) {
        background-color: #e7f1ff;
    }
</style>