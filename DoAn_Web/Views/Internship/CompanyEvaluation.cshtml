@model DoAn_Web.Models.Internship

<div class="container mt-4 admin-container">
    <h3 style="margin-bottom:.6rem;">Đánh giá sinh viên thực tập</h3>

    <div class="report-card" style="padding:.85rem;">
        <div style="display:flex; gap:1rem; align-items:center;">
            <div style="width:72px; height:72px; border-radius:8px; overflow:hidden; display:flex; align-items:center; justify-content:center; background:#f1f5f9;">
                @if (!string.IsNullOrEmpty(Model.Student.AvatarUrl))
                {
                    <img src="@Model.Student.AvatarUrl" alt="avatar" style="width:72px; height:72px; object-fit:cover;" />
                }
                else
                {
                    <div style="font-weight:700; color:#6c757d;">@Model.Student.FullName?.Split(' ').LastOrDefault()?.Substring(0,1)</div>
                }
            </div>

            <div>
                <div style="font-weight:700; color:#343a40; font-size:1.05rem;">@Model.Student.FullName</div>
                <div style="color:#6c757d; font-size:.9rem;">Mã SV: @Model.Student.StudentCode</div>
                <div style="color:#6c757d; font-size:.9rem; margin-top:.25rem;">Thời gian: @Model.StartDate.ToString("dd/MM/yyyy") - @(Model.EndDate?.ToString("dd/MM/yyyy") ?? "Hiện tại")</div>
            </div>

            <div style="margin-left:auto; text-align:right; min-width:120px;">
                <div style="margin-bottom:.3rem;"><strong>Trạng thái:</strong></div>
                <div><span class="status-pill @(Model.Status?.ToLower() == "hoàn thành" || Model.Status?.ToLower() == "completed" ? "submitted" : "pending")">@Model.Status</span></div>
            </div>
        </div>

        <form asp-action="CompanyEvaluation" method="post" id="evaluationForm" style="margin-top:.9rem;">
            <input type="hidden" name="internshipId" value="@Model.InternshipId" />

            <div style="display:flex; gap:1rem; flex-wrap:wrap;">
                <div style="flex:1; min-width:260px;">
                    <h5 style="margin:0 0 .6rem 0;">Tiêu chí đánh giá (Thang điểm 10)</h5>

                    <div style="display:flex; gap:.8rem; flex-wrap:wrap;">
                        <div style="flex:1; min-width:180px;">
                            <label class="fw-bold">1. Chấp hành nội quy</label>
                            <input type="number" class="criteria-input" name="criteriaCompliance" min="0" max="10" step="0.5" required value="@(Model.CompanyEvaluation?.CriteriaCompliance ?? 0)" style="width:100%; padding:.5rem; border-radius:8px; border:1px solid #e9ecef;" />
                            <div style="font-size:.85rem; color:#6c757d; margin-top:.25rem;">Điểm 0–10 (có thể 0.5)</div>
                        </div>

                        <div style="flex:1; min-width:180px;">
                            <label class="fw-bold">2. Thực hiện nhiệm vụ</label>
                            <input type="number" class="criteria-input" name="criteriaTaskPerformance" min="0" max="10" step="0.5" required value="@(Model.CompanyEvaluation?.CriteriaTaskPerformance ?? 0)" style="width:100%; padding:.5rem; border-radius:8px; border:1px solid #e9ecef;" />
                        </div>

                        <div style="flex:1; min-width:180px;">
                            <label class="fw-bold">3. Quan hệ, giao tiếp</label>
                            <input type="number" class="criteria-input" name="criteriaRelationship" min="0" max="10" step="0.5" required value="@(Model.CompanyEvaluation?.CriteriaRelationship ?? 0)" style="width:100%; padding:.5rem; border-radius:8px; border:1px solid #e9ecef;" />
                        </div>
                    </div>

                    <div style="margin-top:.6rem; padding:.6rem; border-radius:8px; background:#fbfbfd; border:1px solid #eef2f6;">
                        <strong>Điểm tổng kết:</strong> <span id="finalScore" style="font-weight:800; color:#157347;">@(Model.CompanyEvaluation?.Score ?? 0)/10</span>
                        <div style="font-size:.85rem; color:#6c757d;">(Trung bình cộng của 3 tiêu chí)</div>
                    </div>

                    <div style="margin-top:.8rem;">
                        <label class="fw-bold">4. Nhận xét khác</label>
                        <textarea name="comments" rows="5" style="width:100%; padding:.6rem; border-radius:8px; border:1px solid #e9ecef;">@(Model.CompanyEvaluation?.Comments ?? "")</textarea>
                    </div>
                </div>

                <div style="width:140px; display:flex; flex-direction:column; align-items:center; gap:.6rem;">
                    <div class="score-circle @(Model.CompanyEvaluation != null && Model.CompanyEvaluation.Score < 5 ? "rejected" : "")">
                        <div class="value">@(Model.CompanyEvaluation?.Score ?? 0)</div>
                    </div>
                    <div style="font-size:.9rem; color:#6c757d; text-align:center;">Điểm hiện tại</div>
                </div>
            </div>

            @if (Model.CompanyEvaluation != null)
            {
                <div style="margin-top:.6rem; padding:.6rem; border-radius:8px; background:#fff4e6; border:1px solid #fde7c7;">Bạn đã đánh giá trước đây vào: @Model.CompanyEvaluation.EvaluationDate.ToString("dd/MM/yyyy") — Lưu sẽ cập nhật đánh giá.</div>
            }

            <div style="margin-top:.8rem; display:flex; gap:.6rem; justify-content:flex-end;">
                <a href="@Url.Action("InternList")" class="uniform-btn">Quay lại</a>
                <button type="submit" class="uniform-btn btn-primary">@(Model.CompanyEvaluation != null ? "Cập nhật đánh giá" : "Lưu đánh giá")</button>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const criteriaInputs = document.querySelectorAll('.criteria-input');
    const finalScoreSpan = document.getElementById('finalScore');

    function updateFinalScore() {
        let total = 0;
        let count = 0;

        criteriaInputs.forEach(input => {
            const value = parseFloat(input.value) || 0;
            total += value;
            count++;
        });

        const average = count > 0 ? total / count : 0;
        const roundedScore = Math.round(average);
        finalScoreSpan.textContent = roundedScore + '/10';

        // update small score-circle value live
        const scoreCircle = document.querySelector('.score-circle .value');
        if (scoreCircle) scoreCircle.textContent = roundedScore;

        const sc = document.querySelector('.score-circle');
        if (sc) {
            if (roundedScore < 5) sc.classList.add('rejected'); else sc.classList.remove('rejected');
        }
    }

    criteriaInputs.forEach(input => input.addEventListener('input', updateFinalScore));

    updateFinalScore();
});
</script>