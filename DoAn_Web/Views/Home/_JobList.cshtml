@model List<DoAn_Web.Models.JobPosting>

<div class="row">
    @foreach (var job in Model)
    {
            <div class="col-md-4 px-3 mb-4">
                <div class="card shadow-sm job-card" style="border: 3px solid #28a745; border-radius: 8px; height: 380px;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-truncate mb-3" style="font-size: 1.1rem; font-weight: 600;">@job.Title</h5>
                        <p class="card-text mb-2"><strong>@job.Company.Name</strong></p>
                        <p class="card-text mb-2"><strong>Địa điểm:</strong> @(job.Location != null ? $"{job.Location.City}, {job.Location.Country}" : "Không xác định")</p>
                        <p class="card-text mb-2 flex-grow-1" style="overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;"><strong>Mô tả:</strong> @job.Description</p>
                        <p class="card-text mb-3"><small class="text-muted">Hạn nộp: @job.ApplicationDeadline.ToString("dd/MM/yyyy")</small></p>
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@job.JobId" class="btn btn-custom job-btn">Xem chi tiết</a>
                        @if (Context.Session.GetInt32("StudentId") != null)
                        {
                                    <a asp-controller="Applications" asp-action="ApplyJob" asp-route-jobId="@job.JobId" class="btn btn-custom job-btn">Ứng tuyển</a>
                        }
                        </div>
                    </div>
                </div>
            </div>
    }
</div>