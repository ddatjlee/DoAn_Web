<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DoAn_Web</title>

    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!--Icon pass-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">


    <!-- File CSS của bạn -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DoAn_Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">DoAn_Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Jobs" asp-action="Index">Việc làm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Companies" asp-action="Index">Công ty</a>
                        </li>
                    </ul>

                    <!-- Hiển thị menu đăng nhập/đăng xuất -->
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("UserEmail") != null)
                        {
                                <li class="nav-item">
                                    <span class="navbar-text text-white me-3">Chào, @Context.Session.GetString("UserName")</span>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-outline-light btn-sm" asp-controller="Home" asp-action="Logout">Đăng xuất</a>
                                </li>
                        }
                        else
                        {
                                <li class="nav-item">
                                    <a class="btn btn-outline-light btn-sm" asp-controller="Home" asp-action="Login">Đăng nhập</a>
                                    <a class="btn btn-outline-light btn-sm" asp-controller="Home" asp-action="Register">Đăng kí</a>
                                </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            &copy; 2025 - DoAn_Web
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
