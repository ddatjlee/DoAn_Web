@{
    ViewData["Title"] = "Đăng nhập Admin";
}

<div class="container mt-4">
    <h3 class="text-center text-primary">Đăng nhập Admin</h3>

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    <form method="post" asp-controller="Home" asp-action="LoginAdmin">
        <div class="mb-3">
            <label class="form-label">Email Admin</label>
            <input type="email" name="adminEmail" class="form-control" placeholder="Nhập email admin" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Mật khẩu</label>
            <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu" required />
        </div>

        <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
    </form>

    <p class="mt-3 text-center">
        Chưa có tài khoản? <a asp-controller="Home" asp-action="Register">Đăng ký</a>
    </p>
</div>
