@model IEnumerable<DoAn_Web.Models.Internship>

<div class="container mt-4 admin-container">
    <h2 style="margin-bottom:1rem;">Danh sách báo cáo thực tập của sinh viên</h2>

    @foreach (var internship in Model)
    {
        <div class="report-card">
            <div class="report-header">
                <div style="display:flex; gap:1rem; align-items:center;">
                    <div style="width:64px; height:64px; border-radius:8px; overflow:hidden; flex-shrink:0; background:#f1f5f9; display:flex; align-items:center; justify-content:center;">
                        @if (!string.IsNullOrEmpty(internship.Student.AvatarUrl))
                        {
                            <img src="@internship.Student.AvatarUrl" alt="avatar" style="width:64px; height:64px; object-fit:cover;" />
                        }
                        else
                        {
                            <div style="font-weight:700; color:#6c757d;">@internship.Student.FullName?.Split(' ').LastOrDefault()?.Substring(0,1)</div>
                        }
                    </div>
                    <div>
                        <h4 style="margin:0;">@internship.Student.FullName</h4>
                        <div style="color:#6c757d; font-size:.95rem; margin-top:.25rem;">
                            <span><strong>Mã SV:</strong> @internship.Student.StudentCode</span>
                            <span style="margin-left:1rem;"><strong>Công ty:</strong> @internship.Company.Name</span>
                        </div>
                        <div style="color:#6c757d; font-size:.92rem; margin-top:.15rem;"> <strong>Thời gian:</strong> @internship.StartDate.ToString("dd/MM/yyyy") - @(internship.EndDate?.ToString("dd/MM/yyyy") ?? "Hiện tại")</div>
                    </div>
                </div>

                <div style="text-align:right; min-width:220px;">
                    <div style="margin-bottom:.25rem;"><strong>Số báo cáo:</strong> @internship.WeeklyReports.Count</div>
                    <div style="margin-bottom:.5rem;">
                        <span class="status-pill @(internship.Status?.ToLower() == "completed" ? "submitted" : "pending")">@internship.Status</span>
                    </div>
                    <div style="display:flex; gap:.5rem; justify-content:flex-end;">
                        <a href="@Url.Action("StudentReports", "Supervisor", new { internshipId = internship.InternshipId })" class="btn btn-outline-dark btn-sm">Xem báo cáo</a>
                        <a href="@Url.Action("Evaluate", "Supervisor", new { internshipId = internship.InternshipId })" class="btn btn-primary btn-sm">Đánh giá</a>
                    </div>
                </div>
            </div>

                    <div style="margin-top:0.8rem;">
                @if (!internship.WeeklyReports.Any())
                {
                    <div class="evaluation-empty">Chưa có báo cáo nào.</div>
                }
                else
                {
                    foreach (var report in internship.WeeklyReports.OrderByDescending(r => r.WeekNumber))
                    {
                        <details class="report-card" style="padding: .75rem; margin-bottom:.6rem;">
                            <summary class="report-header">
                                <div style="display:flex; align-items:center; gap:1rem;">
                                    <div>
                                        <div class="report-week">Tuần @report.WeekNumber</div>
                                        <div class="report-date">@report.ReportDate.ToString("dd/MM/yyyy")</div>
                                    </div>
                                    <div style="margin-left:auto;">
                                            @switch (report.Status?.ToLower())
                                            {
                                                case "approved":
                                                    <span class="status-pill submitted">Đã duyệt</span>
                                                    break;
                                                case "rejected":
                                                    <span class="status-pill rejected">Từ chối</span>
                                                    break;
                                                default:
                                                    <span class="status-pill pending">Chờ duyệt</span>
                                                    break;
                                            }
                                    </div>
                                </div>
                            </summary>

                            <div style="margin-top:.6rem;">
                                <div class="report-content">@report.Content</div>

                                @if (report.Status?.ToLower() == "approved")
                                {
                                    <div class="evaluation-card" style="margin-top:.6rem;">
                                        <h5>Nhận xét của giảng viên</h5>
                                        <div class="evaluation-comment">@report.SupervisorComment</div>
                                        <div class="evaluation-meta">Duyệt lúc: @report.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                }
                                else if (report.Status?.ToLower() == "rejected")
                                {
                                    <div class="evaluation-card" style="margin-top:.6rem; border-left:4px solid #dc3545;">
                                        <h5>Lý do từ chối</h5>
                                        <div class="evaluation-comment">@report.SupervisorComment</div>
                                        <div class="evaluation-meta">Từ chối lúc: @report.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                }
                                else
                                {
                                    <div style="margin-top:.6rem; display:flex; gap:.5rem;">
                                        <a href="@Url.Action("ReviewReport", "Supervisor", new { reportId = report.ReportId })" class="btn btn-primary uniform-btn">Xem &amp; Duyệt</a>
                                        <a href="@Url.Action("DownloadReport", "Supervisor", new { reportId = report.ReportId })" class="btn btn-outline-dark uniform-btn">Tải xuống</a>
                                    </div>
                                }
                            </div>
                        </details>
                    }
                }
            </div>

            <div style="margin-top:.6rem; display:flex; justify-content:flex-end; gap:.6rem;">
                @if ((internship.Status ?? "").Trim() != "Hoàn thành")
                {
                    <form asp-action="MarkInternshipComplete" asp-controller="Supervisor" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="internshipId" value="@internship.InternshipId" />
                        <button type="submit" class="btn btn-outline-dark uniform-btn" onclick="return confirm('Bạn có chắc muốn đánh dấu thực tập này là Hoàn thành? Hành động này sẽ cập nhật trạng thái và có thể thiết lập ngày kết thúc.')">Đánh dấu hoàn thành</button>
                    </form>
                }
            </div>
        </div>
    }
</div>

<style>
    /* Keep small scoped tweaks that map to existing site-no-bootstrap.css classes */
    .report-content { white-space: pre-wrap; margin-top:.4rem; padding:.65rem; border-radius:8px; background:#fbfbfd; border:1px solid #eef2f6; }
    details.report-card { cursor: pointer; }
    details[open] summary { background: #f8fbff; border-radius:8px; }
    summary.report-header { list-style: none; outline: none; }
    summary.report-header::-webkit-details-marker { display:none; }
</style>