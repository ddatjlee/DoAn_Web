@model DoAn_Web.Models.Internship

<div class="account-management-container">
    <h2 class="account-management-title">Danh sách báo cáo thực tập</h2>

    <!-- Internship Information Section -->
    <div class="info-grid">
        <div class="info-item">
            <label>Sinh viên</label>
            <span>@Model.Student.FullName</span>
        </div>
        <div class="info-item">
            <label>Mã SV</label>
            <span>@Model.Student.StudentCode</span>
        </div>
        <div class="info-item">
            <label>Công ty</label>
            <span>@Model.Company.Name</span>
        </div>
        <div class="info-item">
            <label>Giảng viên hướng dẫn</label>
            <span>@Model.Supervisor.Name</span>
        </div>
        <div class="info-item">
            <label>Thời gian</label>
            <span>@Model.StartDate.ToString("dd/MM/yyyy") - @(Model.EndDate?.ToString("dd/MM/yyyy") ?? "Hiện tại")</span>
        </div>
        <div class="info-item">
            <label>Trạng thái</label>
            <span>
                @if (Model.Status?.ToLower() == "completed")
                {
                    <span class="status-text approved">Hoàn thành</span>
                }
                else if (Model.Status?.ToLower() == "in progress")
                {
                    <span class="status-text pending">Đang thực tập</span>
                }
                else
                {
                    <span class="status-text">@Model.Status</span>
                }
            </span>
        </div>
    </div>

    <!-- Weekly Reports Section -->
    <div style="margin-top: 30px;">
        <h3 class="section-title">
            <i class="fas fa-file-alt"></i> Báo cáo tuần
            <a asp-controller="Internship" asp-action="CreateReport" class="btn btn-info uniform-btn" style="float: right; margin-top: -5px;">
                <i class="fas fa-plus"></i> Tạo báo cáo mới
            </a>
        </h3>

        @if (!Model.WeeklyReports.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> Chưa có báo cáo nào. Hãy tạo báo cáo mới!
            </div>
        }
        else
        {
            <div class="reports-list">
                @foreach (var report in Model.WeeklyReports.OrderByDescending(r => r.WeekNumber))
                {
                    <div class="report-card">
                        <div class="report-header" data-toggle="collapse" data-target="#collapse@(report.ReportId)" role="button">
                            <div class="report-header-left">
                                <strong>Tuần @report.WeekNumber</strong>
                                <span class="report-date">@report.ReportDate.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="report-header-right">
                                @switch (report.Status?.ToLower())
                                {
                                    case "approved":
                                        <span class="status-text approved">Đã duyệt</span>
                                        break;
                                    case "rejected":
                                        <span class="status-text rejected">Từ chối</span>
                                        break;
                                    default:
                                        <span class="status-text pending">Chờ duyệt</span>
                                        break;
                                }
                            </div>
                        </div>
                        <div id="collapse@(report.ReportId)" class="report-content collapse">
                            <div class="report-body">
                                <pre class="report-text">@report.Content</pre>
                                @if (!string.IsNullOrEmpty(report.SupervisorComment))
                                {
                                    <div class="feedback-box">
                                        <h5 style="color: #28a745; margin-bottom: 12px;">
                                            <i class="fas fa-comment-dots"></i> Nhận xét của giảng viên
                                        </h5>
                                        <p>@report.SupervisorComment</p>
                                        <small style="color: #6c757d;">Thời gian: @report.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Supervisor Evaluation Section -->
    @if (Model.SupervisorEvaluation != null)
    {
        <div style="margin-top: 30px;">
            <h3 class="section-title">
                <i class="fas fa-star"></i> Đánh giá của giảng viên
            </h3>
            <div class="info-grid">
                <div class="info-item">
                    <label>Điểm</label>
                    <span style="font-size: 1.2rem; font-weight: bold; color: #ff9800;">@Model.SupervisorEvaluation.Score/100</span>
                </div>
                <div class="info-item">
                    <label>Ngày đánh giá</label>
                    <span>@Model.SupervisorEvaluation.EvaluationDate.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="info-item" style="grid-column: 1 / -1;">
                    <label>Nhận xét</label>
                    <p style="margin: 8px 0; color: #495057;">@Model.SupervisorEvaluation.Comments</p>
                </div>
            </div>
        </div>
    }

    <!-- Company Evaluation Section -->
    @if (Model.CompanyEvaluation != null)
    {
        <div style="margin-top: 30px;">
            <h3 class="section-title">
                <i class="fas fa-building"></i> Đánh giá của công ty
            </h3>
            <div class="info-grid">
                <div class="info-item">
                    <label>Điểm</label>
                    <span style="font-size: 1.2rem; font-weight: bold; color: #28a745;">@Model.CompanyEvaluation.Score/100</span>
                </div>
                <div class="info-item">
                    <label>Ngày đánh giá</label>
                    <span>@Model.CompanyEvaluation.EvaluationDate.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="info-item" style="grid-column: 1 / -1;">
                    <label>Nhận xét</label>
                    <p style="margin: 8px 0; color: #495057;">@Model.CompanyEvaluation.Comments</p>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
        padding: 20px;
        background-color: #f8f9fa;
        border-radius: 8px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
    }

    .info-item label {
        font-weight: 600;
        color: #28a745;
        font-size: 0.9rem;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-item span {
        color: #333;
        font-size: 1rem;
    }

    .section-title {
        color: #28a745;
        font-size: 1.3rem;
        font-weight: 600;
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 2px solid #28a745;
    }

    .section-title i {
        margin-right: 8px;
        color: #20c997;
    }

    .reports-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .report-card {
        background: #fff;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .report-card:hover {
        border-color: #28a745;
        box-shadow: 0 2px 8px rgba(40, 167, 69, 0.1);
    }

    .report-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
        background-color: #f8f9fa;
        cursor: pointer;
        user-select: none;
        transition: background-color 0.3s ease;
    }

    .report-header:hover {
        background-color: #e9ecef;
    }

    .report-header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .report-header-left strong {
        color: #333;
        font-size: 1rem;
    }

    .report-date {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .report-header-right {
        display: flex;
        align-items: center;
    }

    .report-content {
        display: none;
    }

    .report-content.show {
        display: block;
    }

    .report-body {
        padding: 20px;
        border-top: 2px solid #e9ecef;
    }

    .report-text {
        white-space: pre-wrap;
        word-wrap: break-word;
        margin: 0 0 15px 0;
        padding: 15px;
        background-color: #f8f9fa;
        border-left: 4px solid #28a745;
        border-radius: 4px;
        font-family: 'Courier New', monospace;
        font-size: 0.95rem;
        color: #333;
    }

    .feedback-box {
        margin-top: 20px;
        padding: 15px;
        background-color: #f0f7f4;
        border-left: 4px solid #20c997;
        border-radius: 4px;
    }

    .feedback-box h5 {
        font-weight: 600;
    }

    .feedback-box p {
        margin: 8px 0;
        color: #495057;
    }

    .status-text {
        font-weight: 600;
        font-size: 0.95rem;
    }

    .status-text.pending {
        color: #ff9800;
    }

    .status-text.approved {
        color: #28a745;
    }

    .status-text.rejected {
        color: #dc3545;
    }

    .uniform-btn {
        background-color: #0066cc;
        border-color: #0066cc;
        color: white;
        padding: 6px 12px;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

    .uniform-btn:hover {
        background-color: #0052a3;
        border-color: #0052a3;
        color: white;
    }

    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
            padding: 15px;
        }

        .report-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .report-header-right {
            width: 100%;
            justify-content: flex-start;
        }

        .reports-list {
            gap: 10px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const reportHeaders = document.querySelectorAll('.report-header');
        
        reportHeaders.forEach(header => {
            header.addEventListener('click', function() {
                const content = this.nextElementSibling;
                const isOpen = content.classList.contains('show');
                
                // Close all other open reports
                document.querySelectorAll('.report-content.show').forEach(openContent => {
                    openContent.classList.remove('show');
                });
                
                // Toggle current report
                if (!isOpen) {
                    content.classList.add('show');
                }
            });
        });
    });
</script>