@model DoAn_Web.Models.Internship

<div class="account-management-container">
    <h2 class="account-management-title">Đánh giá sinh viên thực tập</h2>

    <!-- Student Info Section -->
    <div class="eval-student-card">
        <div class="eval-student-info">
            <div class="eval-student-avatar">
                @if (!string.IsNullOrEmpty(Model.Student.AvatarUrl))
                {
                    <img src="@Model.Student.AvatarUrl" alt="@Model.Student.FullName" />
                }
                else
                {
                    <span>@Model.Student.FullName?.Split(' ').LastOrDefault()?.Substring(0,1)</span>
                }
            </div>
            <div class="eval-student-details">
                <h3>@Model.Student.FullName</h3>
                <div class="eval-meta">
                    <span>@Model.Student.StudentCode</span>
                    <span>@Model.StartDate.ToString("dd/MM/yyyy") - @(Model.EndDate?.ToString("dd/MM/yyyy") ?? "Hiện tại")</span>
                </div>
                <div class="eval-status">
                    @if (Model.Status?.ToLower() == "hoàn thành" || Model.Status?.ToLower() == "completed")
                    {
                        <span class="status-text approved">Hoàn thành</span>
                    }
                    else
                    {
                        <span class="status-text">@Model.Status</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Evaluation Form -->
    <form asp-action="CompanyEvaluation" method="post" id="evaluationForm" class="eval-form">
        <input type="hidden" name="internshipId" value="@Model.InternshipId" />

        <!-- Criteria Section -->
        <div class="report-section">
            <h5>Tiêu chí đánh giá (Thang điểm 10)</h5>

            <div class="criteria-grid">
                <div class="criteria-item">
                    <label>1. Chấp hành nội quy</label>
                    <input type="number" class="criteria-input" name="criteriaCompliance" min="0" max="10" step="0.5" required value="@(Model.CompanyEvaluation?.CriteriaCompliance ?? 0)" />
                    <small>Điểm 0–10 (có thể 0.5)</small>
                </div>

                <div class="criteria-item">
                    <label>2. Thực hiện nhiệm vụ</label>
                    <input type="number" class="criteria-input" name="criteriaTaskPerformance" min="0" max="10" step="0.5" required value="@(Model.CompanyEvaluation?.CriteriaTaskPerformance ?? 0)" />
                </div>

                <div class="criteria-item">
                    <label>3. Quan hệ, giao tiếp</label>
                    <input type="number" class="criteria-input" name="criteriaRelationship" min="0" max="10" step="0.5" required value="@(Model.CompanyEvaluation?.CriteriaRelationship ?? 0)" />
                </div>
            </div>

            <!-- Score Display -->
            <div class="eval-score-box">
                <div class="score-display">
                    <strong>Điểm tổng kết:</strong>
                    <span id="finalScore">@(Model.CompanyEvaluation?.Score ?? 0)/10</span>
                </div>
                <small>(Trung bình cộng của 3 tiêu chí)</small>
            </div>
        </div>

        <!-- Comments Section -->
        <div class="report-section">
            <h5>Nhận xét khác</h5>
            <textarea id="comments" name="comments" class="form-control-custom" rows="6" placeholder="Nhập nhận xét chi tiết về sinh viên...">@(Model.CompanyEvaluation?.Comments ?? "")</textarea>
        </div>

        <!-- Previous Evaluation Notice -->
        @if (Model.CompanyEvaluation != null)
        {
            <div class="alert alert-info">
                Bạn đã đánh giá trước đây vào: <strong>@Model.CompanyEvaluation.EvaluationDate.ToString("dd/MM/yyyy")</strong> — Lưu sẽ cập nhật đánh giá.
            </div>
        }

        <!-- Action Buttons -->
        <div class="eval-actions">
            <a href="@Url.Action("InternList")" class="btn btn-outline-secondary uniform-btn">
                Quay lại
            </a>
            <button type="button" class="btn btn-success uniform-btn" onclick="showLegalBasisModal()">
                @(Model.CompanyEvaluation != null ? "Cập nhật đánh giá" : "Lưu đánh giá")
            </button>
        </div>
    </form>
</div>

<!-- Legal Basis Modal -->
<div id="legalBasisModal" class="legal-modal" style="display: none;">
    <div class="legal-modal-content">
        <div class="legal-modal-header">
            <h3>Cơ sở pháp lý cho việc đánh giá thực tập</h3>
        </div>
        <div class="legal-modal-body" id="legalBasisContent">
            <div class="legal-basis-item">
                <h5>Thông tư 15/2014/TT-BGDĐT</h5>
                <p class="mb-1"><strong>Mã tham chiếu:</strong> TT15/2014/BGDĐT</p>
                <p class="text-muted mb-2">Quy định về đánh giá kết quả học tập, rèn luyện của sinh viên hệ chính quy các trình độ đào tạo của giáo dục đại học.</p>
                <a href="https://thuvienphapluat.vn/van-ban/Giao-duc/Thong-tu-15-2014-TT-BGDDT-danh-gia-ket-qua-hoc-tap-cong-nhan-tot-nghiep-dai-hoc-234145.aspx" target="_blank" class="btn btn-sm btn-outline-success">Xem chi tiết</a>
            </div>
            <div class="legal-basis-item">
                <h5>Quyết định 09/2021/QĐ-BGDĐT</h5>
                <p class="mb-1"><strong>Mã tham chiếu:</strong> QĐ09/2021/BGDĐT</p>
                <p class="text-muted mb-2">Ban hành Quy chế thực tập của sinh viên các cơ sở giáo dục đại học.</p>
                <a href="https://thuvienphapluat.vn/van-ban/Giao-duc/Quyet-dinh-09-2021-QD-BGDDT-Quy-che-dao-tao-trinh-do-dai-hoc-464552.aspx" target="_blank" class="btn btn-sm btn-outline-success">Xem chi tiết</a>
            </div>
            <div class="legal-basis-item">
                <h5>Điều 25 - Đánh giá thực tập</h5>
                <p class="mb-1"><strong>Mã tham chiếu:</strong> Điều 25/Luật 08/2012/QH13</p>
                <p class="text-muted mb-2">Việc đánh giá kết quả thực tập của sinh viên phải dựa trên các tiêu chí: Ý thức chấp hành nội quy, quy định của cơ sở thực tập; Kỹ năng thực hiện công việc được giao; Khả năng giao tiếp, làm việc nhóm.</p>
                <a href="https://thuvienphapluat.vn/van-ban/Giao-duc/Luat-giao-duc-dai-hoc-2012-140444.aspx" target="_blank" class="btn btn-sm btn-outline-success">Xem chi tiết</a>
            </div>
        </div>
        <div class="legal-modal-footer">
            <div class="legal-checkbox">
                <input type="checkbox" id="agreeCheckbox" />
                <label for="agreeCheckbox">Tôi đã đọc và hiểu các cơ sở pháp lý trên, đồng ý thực hiện đánh giá theo đúng quy định.</label>
            </div>
            <div class="legal-buttons">
                <button type="button" class="btn btn-outline-secondary uniform-btn" onclick="closeLegalModal()">Hủy</button>
                <button type="button" class="btn btn-success uniform-btn" onclick="submitEvaluation()" id="confirmBtn" disabled>Xác nhận đánh giá</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const criteriaInputs = document.querySelectorAll('.criteria-input');
    const finalScoreSpan = document.getElementById('finalScore');

    function updateFinalScore() {
        let total = 0;
        let count = 0;

        criteriaInputs.forEach(input => {
            const value = parseFloat(input.value) || 0;
            total += value;
            count++;
        });

        const average = count > 0 ? total / count : 0;
        const roundedScore = Math.round(average);
        finalScoreSpan.textContent = roundedScore + '/10';
    }

    criteriaInputs.forEach(input => input.addEventListener('input', updateFinalScore));

    updateFinalScore();

    // Checkbox toggle
    const agreeCheckbox = document.getElementById('agreeCheckbox');
    const confirmBtn = document.getElementById('confirmBtn');
    
    if (agreeCheckbox && confirmBtn) {
        agreeCheckbox.addEventListener('change', function() {
            confirmBtn.disabled = !this.checked;
        });
    }
});

function showLegalBasisModal() {
    document.getElementById('legalBasisModal').style.display = 'flex';
    document.getElementById('agreeCheckbox').checked = false;
    document.getElementById('confirmBtn').disabled = true;
}

function closeLegalModal() {
    document.getElementById('legalBasisModal').style.display = 'none';
}

function submitEvaluation() {
    document.getElementById('evaluationForm').submit();
}
</script>

<style>
